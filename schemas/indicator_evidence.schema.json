{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "const": "AP-G56-22",
          "default": "AP-G56-22",
          "title": "Document Id",
          "type": "string"
        },
        "guideline_version": {
          "const": "AP-G56-22",
          "default": "AP-G56-22",
          "title": "Guideline Version",
          "type": "string"
        },
        "document_sha256": {
          "title": "Document Sha256",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "printed_page": {
          "title": "Printed Page",
          "type": "integer"
        },
        "pdf_page": {
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "table_row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Row"
        },
        "licence_context": {
          "const": "commercial",
          "default": "commercial",
          "title": "Licence Context",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "commercial_table",
            "shared_guidance"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "evidence_text": {
          "title": "Evidence Text",
          "type": "string"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        },
        "retrieval_score": {
          "title": "Retrieval Score",
          "type": "number"
        },
        "score_type": {
          "title": "Score Type",
          "type": "string"
        },
        "verified_against_source": {
          "const": true,
          "default": true,
          "title": "Verified Against Source",
          "type": "boolean"
        },
        "clinical_review_status": {
          "const": "pending",
          "default": "pending",
          "title": "Clinical Review Status",
          "type": "string"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "standard": {
          "const": "commercial",
          "default": "commercial",
          "title": "Standard",
          "type": "string"
        },
        "criterion_type": {
          "enum": [
            "unconditional",
            "conditional",
            "mixed",
            "general"
          ],
          "title": "Criterion Type",
          "type": "string"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        },
        "bounding_box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounding Box",
          "type": "array"
        },
        "cross_references": {
          "items": {
            "type": "string"
          },
          "title": "Cross References",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "chunk_id",
        "document_sha256",
        "source_path",
        "section",
        "printed_page",
        "pdf_page",
        "bbox",
        "applicability",
        "evidence_text",
        "text_sha256",
        "retrieval_score",
        "score_type",
        "condition",
        "criterion_type",
        "source_text",
        "bounding_box"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "indicator_id": {
      "title": "Indicator Id",
      "type": "string"
    },
    "module": {
      "enum": [
        "hypertension",
        "vision",
        "hearing",
        "blackout",
        "diabetes"
      ],
      "title": "Module",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "source_document": {
      "title": "Source Document",
      "type": "string"
    },
    "source_text_sha256": {
      "title": "Source Text Sha256",
      "type": "string"
    },
    "start": {
      "title": "Start",
      "type": "integer"
    },
    "end": {
      "title": "End",
      "type": "integer"
    },
    "index_sha256": {
      "title": "Index Sha256",
      "type": "string"
    },
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "status": {
      "enum": [
        "candidates_found",
        "no_candidates"
      ],
      "title": "Status",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "related_citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Related Citations",
      "type": "array"
    },
    "ranked_candidates": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Ranked Candidates",
      "type": "array"
    },
    "filters": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Filters",
      "type": "object"
    },
    "assessment_outcome": {
      "default": null,
      "title": "Assessment Outcome",
      "type": "null"
    },
    "review_required": {
      "const": true,
      "default": true,
      "title": "Review Required",
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "indicator_id",
    "module",
    "query",
    "source_document",
    "source_text_sha256",
    "start",
    "end",
    "index_sha256",
    "backend",
    "status",
    "citations",
    "related_citations",
    "ranked_candidates",
    "filters"
  ],
  "title": "IndicatorEvidence",
  "type": "object"
}
