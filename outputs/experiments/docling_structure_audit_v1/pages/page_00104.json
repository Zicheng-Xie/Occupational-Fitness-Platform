  "regions": [
    {
      "kind": "text",
      "native_ref": "#/texts/128",
      "text": "For the purposes of this document, a 'severe hypoglycaemic event' is defined as an event of hypoglycaemia of sufficient severity such that the person is unable to treat the hypoglycaemia themselves and so requires someone else to administer treatment. It includes hypoglycaemia causing loss of consciousness or seizure. It can occur during driving or at any other time of the day or night. A severe hypoglycaemic event is particularly relevant to driving because it affects brain function and may cause impairment of perception, motor skills or consciousness. It may also cause abnormal behaviour. A severe hypoglycaemic event is to be distinguished from mild hypoglycaemic events, the latter with symptoms such as sweating, tremulousness, hunger and tingling around the mouth, which are common occurrences in the life of a person with diabetes treated with insulin and some hypoglycaemic agents.",
      "bbox_top_left": [
        56.6929,
        64.35609999999997,
        280.74089999999995,
        208.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 56.6929,
          "t": 777.5339,
          "r": 280.74089999999995,
          "b": 633.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          474,
          896
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/130",
      "text": "Potential causes 7",
      "bbox_top_left": [
        56.6929,
        227.30890699999998,
        153.531685,
        239.3048469879518
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 56.6929,
          "t": 614.581093,
          "r": 153.531685,
          "b": 602.5851530120482,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          18
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/131",
      "text": "Hypoglycaemia may be caused by many factors including non-adherence or alteration to medication, unexpected exertion, alcohol intake or irregular meals. Meal regularity and variability in medication administration may be important considerations for long-distance commercial driving or for drivers operating on shifts. Impairment of consciousness and judgement can develop rapidly and result in loss of control of a vehicle. Excessively tight control may contribute to hypoglycaemia.",
      "bbox_top_left": [
        56.6929,
        259.35609999999997,
        286.49389999999994,
        418.76024365152915
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 56.6929,
          "t": 582.5339,
          "r": 286.49389999999994,
          "b": 423.12975634847083,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          483
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/132",
      "text": "Advice to drivers",
      "bbox_top_left": [
        56.6929,
        438.02209999999997,
        152.45089999999996,
        449.30484698795175
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 56.6929,
          "t": 403.8679,
          "r": 152.45089999999996,
          "b": 392.58515301204824,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          17
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/133",
      "text": "The driver should be advised not to drive if a severe hypoglycaemic event is experienced while driving or at any other time, until they have been cleared to drive by a medical practitioner. The driver should also be advised to take appropriate precautionary steps to help avoid a severe hypoglycaemic event - for example, by:",
      "bbox_top_left": [
        56.6929,
        469.35609999999997,
        285.46759999999995,
        568.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 56.6929,
          "t": 372.5339,
          "r": 285.46759999999995,
          "b": 273.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          325
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/134",
      "text": "complying with general medical review requirements as requested by their general practitioner or specialist",
      "bbox_top_left": [
        307.559,
        64.35609999999997,
        531.16,
        103.76024365152921
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 307.559,
          "t": 777.5339,
          "r": 531.16,
          "b": 738.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          109
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/135",
      "text": "not driving if either their blood glucose is at or less than 5 mmol/L or if, while wearing a continuous or flash glucose monitor, the predicted glucose level is showing downward trends into the hypoglycaemia range (measured when the vehicle is parked)",
      "bbox_top_left": [
        307.559,
        109.35609999999997,
        538.5839,
        193.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 307.559,
          "t": 732.5339,
          "r": 538.5839,
          "b": 648.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          253
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/136",
      "text": "wearing a continuous or flash glucose monitor, preferably with an active hypoglycaemia alert or alarm",
      "bbox_top_left": [
        307.559,
        199.35609999999997,
        504.9579999999999,
        238.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 307.559,
          "t": 642.5339,
          "r": 504.9579999999999,
          "b": 603.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          103
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/137",
      "text": "not driving for more than two hours without considering having a snack",
      "bbox_top_left": [
        307.559,
        244.35609999999997,
        529.1139999999999,
        268.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 307.559,
          "t": 597.5339,
          "r": 529.1139999999999,
          "b": 573.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          72
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/138",
      "text": "not delaying or missing a main meal",
      "bbox_top_left": [
        307.559,
        274.35609999999997,
        495.25599999999974,
        283.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 307.559,
          "t": 567.5339,
          "r": 495.25599999999974,
          "b": 558.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          37
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/139",
      "text": "self-monitoring blood glucose levels before driving and every two hours during a journey, as reasonably practical",
      "bbox_top_left": [
        307.559,
        289.35609999999997,
        531.4239999999998,
        328.7602436515292
      ],
      "native_provenance": {
        "page_no": 9,
        "bbox": {
          "l": 307.559,
          "t": 552.5339,
          "r": 531.4239999999998,
          "b": 513.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          115
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/140",
      "text": "carrying adequate glucose in the vehicle for self-treatment",
      "bbox_top_left": [
