    <edge source="Type 2 Diabetes" target="Sleep Apnoea">
      <data key="d7">3.0</data>
      <data key="d8">Sleep apnoea is more common in people with type 2 diabetes.&lt;SEP&gt;Sleep apnoea is a common comorbidity affecting many people with type 2 diabetes.</data>
      <data key="d9">comorbidity,prevalence,sleep disorder</data>
      <data key="d10">AFTD2022-DM-COM-001-chunk-000&lt;SEP&gt;AFTD2022-EXP-513404205a2966cb-chunk-000&lt;SEP&gt;AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d11">AFTD2022-DM-COM-001&lt;SEP&gt;AFTD2022-EXP-513404205a2966cb&lt;SEP&gt;AFTD2022-EXP-d6142190f29b7662</data>
      <data key="d12">1792687240</data>
      <data key="d13" />
    </edge>
    <edge source="Type 2 Diabetes" target="Impaired Hypoglycaemia Awareness">
      <data key="d7">1.0</data>
      <data key="d8">Impaired hypoglycaemia awareness occurs in about 10 per cent of people with type 2 diabetes.</data>
      <data key="d9">occurrence,percentage,prevalence</data>
      <data key="d10">AFTD2022-EXP-fbc891254df13760-chunk-000</data>
      <data key="d11">AFTD2022-EXP-fbc891254df13760</data>
      <data key="d12">1792687114</data>
      <data key="d13" />
    </edge>
    <edge source="Type 2 Diabetes" target="Cardiovascular Risk Factors">
      <data key="d7">1.0</data>
      <data key="d8">People with type 2 diabetes should have their cardiovascular risk factors periodically assessed and treated as required according to good medical practice.</data>
      <data key="d9">assessment,medical practice,treatment</data>
      <data key="d10">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d11">AFTD2022-EXP-d6142190f29b7662</data>
      <data key="d12">1792687240</data>
      <data key="d13" />
    </edge>
    <edge source="Sleep Apnoea" target="Road Safety">
      <data key="d7">1.0</data>
      <data key="d8">Sleep apnoea has substantial implications for road safety among individuals with diabetes.</data>
      <data key="d9">implications,risk</data>
      <data key="d10">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d11">AFTD2022-EXP-d6142190f29b7662</data>
      <data key="d12">1792687240</data>
      <data key="d13" />
    </edge>
    <edge source="Sleep Apnoea" target="BMI">
      <data key="d7">1.0</data>
      <data key="d8">A BMI greater than 35 is identified as a potential sign of sleep apnoea that health professionals should be alert to.</data>
      <data key="d9">signs,threshold</data>
      <data key="d10">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d11">AFTD2022-EXP-d6142190f29b7662</data>
