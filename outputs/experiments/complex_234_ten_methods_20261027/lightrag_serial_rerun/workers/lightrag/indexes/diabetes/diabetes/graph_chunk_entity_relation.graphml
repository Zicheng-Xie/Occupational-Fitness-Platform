    <edge source="Diabetes" target="Commercial Standards">
      <data key="d7">1.0</data>
      <data key="d8">The standards apply to drivers with diabetes treated by diet and exercise alone who may drive without licence restriction.</data>
      <data key="d9">medical condition,regulation</data>
