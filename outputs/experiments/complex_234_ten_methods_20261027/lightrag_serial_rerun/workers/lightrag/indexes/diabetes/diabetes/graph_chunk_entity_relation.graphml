      <data key="d0">Epworth Sleepiness Scale</data>
      <data key="d1">artifact</data>
      <data key="d2">A standardized tool used by treating health professionals to assess the level of daytime sleepiness in patients with diabetes and sleep apnoea.</data>
      <data key="d3">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
