    <edge source="Interstate Multiple Combination Vehicle Driver" target="Conditional Licence">
      <data key="d7">1.0</data>
      <data key="d8">An interstate multiple combination vehicle driver has a different licence status compared to a farmer due to the nature of their driving task.</data>
      <data key="d9">driving task,licence status</data>
