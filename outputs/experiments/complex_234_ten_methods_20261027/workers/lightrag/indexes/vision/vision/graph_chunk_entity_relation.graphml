      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d2">Fixation monitoring must be performed and recorded on the test to ensure validity.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
