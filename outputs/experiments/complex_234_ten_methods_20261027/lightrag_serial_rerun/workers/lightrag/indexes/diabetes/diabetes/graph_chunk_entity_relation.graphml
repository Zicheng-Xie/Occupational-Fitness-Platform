      <data key="d5">1792687257</data>
      <data key="d6" />
    </node>
    <node id="Insulin Treatment">
      <data key="d0">Insulin Treatment</data>
      <data key="d1">method</data>
      <data key="d2">A medical procedure involving the administration of insulin to manage blood glucose levels in individuals with diabetes.</data>
      <data key="d3">AFTD2022-DM-COM-009-chunk-000</data>
      <data key="d4">AFTD2022-DM-COM-009</data>
      <data key="d5">1792686967</data>
      <data key="d6" />
    </node>
    <node id="Blood Glucose Monitoring Records">
      <data key="d0">Blood Glucose Monitoring Records</data>
      <data key="d1">data</data>
      <data key="d2">Structured information documenting the measurement of blood sugar levels over a period of at least three months, used to assess driving fitness.</data>
      <data key="d3">AFTD2022-DM-COM-009-chunk-000</data>
      <data key="d4">AFTD2022-DM-COM-009</data>
      <data key="d5">1792686967</data>
      <data key="d6" />
    </node>
    <node id="Gestational Diabetes Mellitus">
      <data key="d0">Gestational Diabetes Mellitus</data>
      <data key="d1">condition</data>
      <data key="d2">A self-limiting condition affecting women during pregnancy.</data>
      <data key="d3">AFTD2022-DM-COM-010-chunk-000</data>
      <data key="d4">AFTD2022-DM-COM-010</data>
      <data key="d5">1792686975</data>
      <data key="d6" />
    </node>
