          "document_id": "AP-G56-22",
          "guideline_version": "AP-G56-22",
          "document_sha256": "5811cfbb29c4db2cec704033ec2ee31506e78445ed8108e72d324cbef780500c",
          "source_path": "data/knowledge/raw/ap_g56_22.pdf",
          "section": "3.3",
