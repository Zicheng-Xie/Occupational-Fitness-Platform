    <edge source="Diabetes" target="Treating Doctor">
      <data key="d7">2.0</data>
      <data key="d8">The treating doctor periodically reviews the patient regarding the progression of their diabetes.&lt;SEP&gt;A person with diabetes should be reviewed periodically by their treating doctor regarding the progression of their condition.</data>
      <data key="d9">medical care,monitoring,progression</data>
