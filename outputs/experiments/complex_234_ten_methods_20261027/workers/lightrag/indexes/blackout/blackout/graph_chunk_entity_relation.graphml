    <node id="Cardiovascular">
      <data key="d0">Cardiovascular</data>
      <data key="d1">concept</data>
      <data key="d2">A medical field or system related to the heart and blood vessels, investigated in this context.</data>
      <data key="d3">AFTD2022-BLK-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-001</data>
      <data key="d5">1792686726</data>
      <data key="d6" />
    </node>
    <node id="Neurological">
      <data key="d0">Neurological</data>
      <data key="d1">concept</data>
      <data key="d2">A medical field or system related to the nervous system, investigated in this context.</data>
      <data key="d3">AFTD2022-BLK-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-001</data>
      <data key="d5">1792686726</data>
      <data key="d6" />
    </node>
    <node id="Specialists">
      <data key="d0">Specialists</data>
      <data key="d1">organization</data>
      <data key="d2">Medical experts to whom patients are referred for further investigation.&lt;SEP&gt;Medical professionals to whom patients are referred for investigation.</data>
      <data key="d3">AFTD2022-BLK-COM-001-chunk-000&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-001&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973</data>
