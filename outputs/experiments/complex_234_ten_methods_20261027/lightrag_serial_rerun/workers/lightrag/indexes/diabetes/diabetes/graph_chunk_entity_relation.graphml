    </node>
    <node id="BMI">
      <data key="d0">BMI</data>
      <data key="d1">data</data>
      <data key="d2">Body Mass Index, a metric where values greater than 35 are considered potential signs of sleep apnoea.</data>
      <data key="d3">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d6142190f29b7662</data>
