  "internal_metadata": {
    "rule_engine_contract": "internal",
    "narrative_context": {
      "RAG-82fa2f088c4d522b": [
        {
          "start": 0,
          "end": 393,
          "quote": "The driver can follow a quiet face-to-face conversation but repeatedly asks dispatch to repeat radio instructions when the engine is running, turns his left ear toward the nurse and says the reversing alarm seems much quieter than last month; he uses hearing aids inconsistently because one whistles, although being able to hear the nurse today does not establish an unaided hearing threshold.",
          "line_start": 1,
          "line_end": 1,
          "pdf_page": null
        },
        {
          "start": 397,
          "end": 746,
          "quote": "A phone photograph shows 35 dB at 500 Hz and 50 dB at 1000 Hz without an identified ear, with the 2000 and 3000 Hz values cut off and no indication of whether an aid was worn; the nurse therefore cannot calculate an unaided better-ear average or regard this photograph as a complete audiogram, and the audiologist's signed report has been requested.",
          "line_start": 3,
          "line_end": 3,
          "pdf_page": null
        }
      ],
