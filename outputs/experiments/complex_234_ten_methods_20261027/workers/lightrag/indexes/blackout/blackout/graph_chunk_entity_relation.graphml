    </edge>
    <edge source="Distraction" target="Drivers">
      <data key="d7">1.0</data>
      <data key="d8">A driving mishap may be caused by distraction, such as engaging in a mobile phone conversation.</data>
      <data key="d9">cause,mobile phone</data>
