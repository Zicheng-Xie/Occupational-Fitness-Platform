    <node id="Fitness to Drive">
      <data key="d0">Fitness to Drive</data>
      <data key="d1">concept</data>
      <data key="d2">The assessment of whether an individual is medically fit to operate a vehicle, based on first principles when specific blackout causes are excluded from standards.</data>
      <data key="d3">AFTD2022-EXP-2332d9548f2abd01-chunk-000</data>
