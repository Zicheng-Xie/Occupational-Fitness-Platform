    },
    {
      "kind": "text",
      "native_ref": "#/texts/143",
      "text": "turning off the engine and removing the keys from the ignition",
      "bbox_top_left": [
        323.5748,
        423.52009999999996,
        529.5977999999999,
        448.76024365152915
      ],
