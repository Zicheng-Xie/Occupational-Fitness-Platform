    <edge source="Blackout of Undetermined Mechanism" target="Fitness to Drive Assessment">
      <data key="d7">1.0</data>
      <data key="d8">When the mechanism of a blackout cannot be determined, fitness to drive should be assessed.</data>
      <data key="d9">driving safety,medical evaluation</data>
      <data key="d10">AFTD2022-EXP-3a8e08652c83a2d0-chunk-000</data>
      <data key="d11">AFTD2022-EXP-3a8e08652c83a2d0</data>
