      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Driving Record">
      <data key="d7">1.0</data>
      <data key="d8">The person's driving record before and since the hearing loss is assessed to determine their eligibility for a conditional licence.</data>
      <data key="d9">driving behavior,eligibility,history</data>
      <data key="d10">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d11">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d12">1792687404</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Driving Task">
      <data key="d7">1.0</data>
      <data key="d8">The nature of the driving task, including vehicle type and road conditions, is considered in the assessment for a conditional licence.</data>
      <data key="d9">assessment,distances,roads,vehicle type</data>
      <data key="d10">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
