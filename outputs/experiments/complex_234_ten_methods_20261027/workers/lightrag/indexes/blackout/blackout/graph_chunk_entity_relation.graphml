      <data key="d6" />
    </node>
    <node id="People">
      <data key="d0">People</data>
      <data key="d3">AFTD2022-BLK-COM-001-chunk-000&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d2">People are advised to be referred to several specialists after investigations.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">AFTD2022-BLK-COM-001</data>
      <data key="d5">1792686726</data>
      <data key="d6" />
