      "RAG-05752279ebee6157": [
        {
          "start": 0,
          "end": 385,
          "quote": "The driver calls yesterday's event a brief blank spell rather than a blackout: while seated after a delivery he stopped answering for roughly 20 seconds and cannot remember his colleague moving the cup from his hand, although he did not fall and denies having lost consciousness; the colleague describes an unresponsive stare, and whether awareness was actually lost remains uncertain.",
          "line_start": 1,
          "line_end": 1,
          "pdf_page": null
        },
        {
          "start": 389,
          "end": 748,
          "quote": "A similar episode may have occurred ten days earlier, but dates and duration are unclear; the referral mentions a possible rhythm disturbance, seizure or sleep-related event without a confirmed diagnosis, and both ambulatory cardiac monitoring and neurological review are pending, so neither a benign cause nor a recurrence-free interval has been established.",
          "line_start": 3,
          "line_end": 3,
          "pdf_page": null
        }
