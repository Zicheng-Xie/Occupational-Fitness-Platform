      <data key="d13" />
    </edge>
    <edge source="Insulin-Treated Diabetes" target="Hypoglycaemia">
      <data key="d7">1.0</data>
      <data key="d8">The main hazard in people with insulin-treated diabetes is the unexpected occurrence of hypoglycaemia.</data>
      <data key="d9">hazard,medical risk</data>
