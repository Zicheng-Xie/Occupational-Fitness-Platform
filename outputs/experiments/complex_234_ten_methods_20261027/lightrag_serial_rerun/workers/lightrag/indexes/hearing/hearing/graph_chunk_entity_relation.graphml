  <graph edgedefault="undirected">
    <node id="Driver Licensing Authority">
      <data key="d0">Driver Licensing Authority</data>
      <data key="d1">organization</data>
      <data key="d2">The entity responsible for issuing, renewing, suspending, or cancelling a person's driver licence, including conditional licences.&lt;SEP&gt;The body responsible for granting conditional licences and considering the nature of driving tasks alongside medical conditions.&lt;SEP&gt;The governmental or regulatory body responsible for issuing licenses and reviewing applications based on medical and practical data.&lt;SEP&gt;The government body responsible for issuing conditional driving licenses subject to periodic review.&lt;SEP&gt;The governmental body responsible for issuing and managing driver licenses.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000&lt;SEP&gt;AFTD2022-EXP-d83c4a25c127adee-chunk-000&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4&lt;SEP&gt;AFTD2022-EXP-d83c4a25c127adee&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="Person">
      <data key="d0">Person</data>
      <data key="d1">person</data>
      <data key="d2">An individual who holds a driver licence and is subject to licensing decisions based on health and driving performance.&lt;SEP&gt;An individual who undergoes clinical assessment and may be referred for further testing.&lt;SEP&gt;An individual who is assessed for eligibility to hold an unconditional licence based on hearing capabilities.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-001-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4&lt;SEP&gt;AFTD2022-HEAR-COM-001&lt;SEP&gt;AFTD2022-HEAR-COM-002</data>
      <data key="d5">1792687436</data>
      <data key="d6" />
    </node>
    <node id="Driver Licence">
      <data key="d0">Driver Licence</data>
      <data key="d1">artifact</data>
      <data key="d2">A document or credential that may be conditional, issued by the Driver Licensing Authority after consideration of relevant factors.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4</data>
      <data key="d5">1792687301</data>
      <data key="d6" />
    </node>
    <node id="Health Professional">
      <data key="d0">Health Professional</data>
      <data key="d1">person</data>
      <data key="d2">An individual who provides details of medical criteria not met, evidence of criteria met, and proposed conditions for a conditional licence.&lt;SEP&gt;A qualified individual who advises on the frequency of reviews based on the natural history of a patient's condition.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Medical Criteria">
      <data key="d0">Medical Criteria</data>
      <data key="d1">concept</data>
      <data key="d2">Specific health standards that must be met or are not met to determine fitness to drive.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4</data>
      <data key="d5">1792687301</data>
      <data key="d6" />
    </node>
    <node id="Hearing Impairment">
      <data key="d0">Hearing Impairment</data>
      <data key="d1">concept</data>
      <data key="d2">A medical condition involving reduced hearing ability that may affect fitness to drive when combined with other conditions.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4</data>
      <data key="d5">1792687301</data>
      <data key="d6" />
    </node>
    <node id="Visual Impairment">
      <data key="d0">Visual Impairment</data>
      <data key="d1">concept</data>
      <data key="d2">A medical condition involving reduced vision ability that may affect fitness to drive when combined with other conditions.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4</data>
      <data key="d5">1792687301</data>
      <data key="d6" />
    </node>
    <node id="Cognitive Impairment">
      <data key="d0">Cognitive Impairment</data>
      <data key="d1">concept</data>
      <data key="d2">A medical condition involving reduced mental processing ability that may affect fitness to drive when combined with other conditions.&lt;SEP&gt;A medical condition affecting mental processes or memory that may coexist with hearing loss and affect driving fitness.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Older Drivers and Age-Related Changes">
      <data key="d0">Older Drivers and Age-Related Changes</data>
      <data key="d1">content</data>
      <data key="d2">A section referenced in the text discussing age-related changes relevant to driving fitness.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4</data>
      <data key="d5">1792687301</data>
      <data key="d6" />
    </node>
    <node id="Multiple Medical Conditions">
      <data key="d0">Multiple Medical Conditions</data>
      <data key="d1">concept</data>
      <data key="d2">The state of having concurrent medical conditions that may combine to affect overall fitness to drive.</data>
      <data key="d3">AFTD2022-EXP-1ca53671ba0f3fb4-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1ca53671ba0f3fb4</data>
      <data key="d5">1792687301</data>
      <data key="d6" />
    </node>
    <node id="Audiologist">
      <data key="d0">Audiologist</data>
      <data key="d1">person</data>
      <data key="d2">An individual accredited as an audiologist by Audiology Australia or the Australian College of Audiology.&lt;SEP&gt;A healthcare professional specializing in the diagnosis and treatment of hearing disorders who provides information regarding a driver's hearing status.&lt;SEP&gt;A healthcare professional specializing in the diagnosis and treatment of hearing disorders who can conduct individualized assessments.&lt;SEP&gt;A healthcare professional specializing in hearing disorders who provides information relevant to driving assessments.&lt;SEP&gt;A healthcare professional specializing in the diagnosis and treatment of hearing disorders.</data>
      <data key="d3">AFTD2022-EXP-3489e87ef8a4fff2-chunk-000&lt;SEP&gt;AFTD2022-EXP-7f3c434bba3c53df-chunk-000&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-3489e87ef8a4fff2&lt;SEP&gt;AFTD2022-EXP-7f3c434bba3c53df&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="Audiology Australia">
      <data key="d0">Audiology Australia</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that accredits individuals as audiologists.</data>
      <data key="d3">AFTD2022-EXP-3489e87ef8a4fff2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-3489e87ef8a4fff2</data>
      <data key="d5">1792687309</data>
      <data key="d6" />
    </node>
    <node id="Australian College of Audiology">
      <data key="d0">Australian College of Audiology</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that accredits individuals as audiologists and audiometrists.</data>
      <data key="d3">AFTD2022-EXP-3489e87ef8a4fff2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-3489e87ef8a4fff2</data>
      <data key="d5">1792687309</data>
      <data key="d6" />
    </node>
    <node id="Audiometrist">
      <data key="d0">Audiometrist</data>
      <data key="d1">person</data>
      <data key="d2">An individual accredited as an audiometrist by the Australian College of Audiology or the Hearing Aid Audiology Society of Australia.</data>
      <data key="d3">AFTD2022-EXP-3489e87ef8a4fff2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-3489e87ef8a4fff2</data>
      <data key="d5">1792687309</data>
      <data key="d6" />
    </node>
    <node id="Hearing Aid Audiology Society of Australia">
      <data key="d0">Hearing Aid Audiology Society of Australia</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that accredits individuals as audiometrists.</data>
      <data key="d3">AFTD2022-EXP-3489e87ef8a4fff2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-3489e87ef8a4fff2</data>
      <data key="d5">1792687309</data>
      <data key="d6" />
    </node>
    <node id="Comorbidities">
      <data key="d0">Comorbidities</data>
      <data key="d1">concept</data>
      <data key="d2">Medical conditions that coexist with other diseases or disorders, potentially affecting overall health and functional capacity.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Functional Abilities">
      <data key="d0">Functional Abilities</data>
      <data key="d1">concept</data>
      <data key="d2">The physical and mental capabilities required to perform tasks, which may be reduced due to various factors.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Driving">
      <data key="d0">Driving</data>
      <data key="d1">activity</data>
      <data key="d2">The act of operating a vehicle, requiring specific cognitive and physical skills such as reaction time and neck rotation.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Reaction Times">
      <data key="d0">Reaction Times</data>
      <data key="d1">data</data>
      <data key="d2">The duration required for an individual to respond to a stimulus, which can be slowed by musculoskeletal changes or comorbidities.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Neck Rotation">
      <data key="d0">Neck Rotation</data>
      <data key="d1">method</data>
      <data key="d2">The physical movement of the neck, essential for driving tasks but potentially reduced due to musculoskeletal changes.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Musculoskeletal Changes">
      <data key="d0">Musculoskeletal Changes</data>
      <data key="d1">concept</data>
      <data key="d2">Alterations in the muscles and skeletal structure that can impact physical function and range of motion.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Vigilance">
      <data key="d0">Vigilance</data>
      <data key="d1">concept</data>
      <data key="d2">The state of being awake and alert, crucial for maintaining safety during activities like driving.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Alertness">
      <data key="d0">Alertness</data>
      <data key="d1">concept</data>
      <data key="d2">A state of readiness and awareness that helps an individual respond quickly to changes in their environment.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Arousal">
      <data key="d0">Arousal</data>
      <data key="d1">concept</data>
      <data key="d2">The physiological and psychological state of being awake and responsive, important for maintaining general attention.</data>
      <data key="d3">AFTD2022-EXP-44d20141744cafb2-chunk-000</data>
      <data key="d4">AFTD2022-EXP-44d20141744cafb2</data>
      <data key="d5">1792687322</data>
      <data key="d6" />
    </node>
    <node id="Commercial standards">
      <data key="d0">Commercial standards</data>
      <data key="d1">concept</data>
      <data key="d2">A set of requirements for drivers of heavy vehicles, public passenger vehicles, or those requiring a dangerous goods driver licence.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Hearing loss">
      <data key="d0">Hearing loss</data>
      <data key="d1">condition</data>
      <data key="d2">A condition characterized by reduced auditory sensitivity, measured in decibels (dB) across specific frequencies.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Unconditional licence">
      <data key="d0">Unconditional licence</data>
      <data key="d1">content</data>
      <data key="d2">A driving permit granted without restrictions, which a person is not fit to hold if they have unaided hearing loss of 40 dB or greater in the better ear.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Conditional licence">
      <data key="d0">Conditional licence</data>
      <data key="d1">content</data>
      <data key="d2">A driving permit that may be granted subject to periodic review, considering factors such as the nature of the driving task and medical assessments.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Driver licensing authority">
      <data key="d0">Driver licensing authority</data>
      <data key="d1">organization</data>
      <data key="d2">The body responsible for evaluating driver fitness and issuing or reviewing driving licences.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Audiometry">
      <data key="d0">Audiometry</data>
      <data key="d1">method</data>
      <data key="d2">A clinical assessment procedure used to detect possible hearing loss.&lt;SEP&gt;A diagnostic procedure used to measure hearing ability, performed when hearing loss is suspected.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df&lt;SEP&gt;AFTD2022-HEAR-COM-001</data>
      <data key="d5">1792687428</data>
      <data key="d6" />
    </node>
    <node id="Hearing aid">
      <data key="d0">Hearing aid</data>
      <data key="d1">artifact</data>
      <data key="d2">A device used to amplify sound, which may be required to meet commercial standards for drivers with hearing impairment.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="ENT specialist">
      <data key="d0">ENT specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical professional specializing in ear, nose, and throat conditions who provides information regarding a driver's hearing status.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Practical driver assessment">
      <data key="d0">Practical driver assessment</data>
      <data key="d1">method</data>
      <data key="d2">An evaluation process used to determine if a driver can safely operate a vehicle under real-world conditions.</data>
      <data key="d3">AFTD2022-EXP-7f3c434bba3c53df-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7f3c434bba3c53df</data>
      <data key="d5">1792687339</data>
      <data key="d6" />
    </node>
    <node id="Musculoskeletal conditions">
      <data key="d0">Musculoskeletal conditions</data>
      <data key="d1">concept</data>
      <data key="d2">A category of impairments referenced in Part B section 5 that may coexist with hearing loss and deafness.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Vision and eye disorders">
      <data key="d0">Vision and eye disorders</data>
      <data key="d1">concept</data>
      <data key="d2">A category of impairments referenced in Part B section 10 that may coexist with hearing loss and deafness.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Hearing loss and deafness">
      <data key="d0">Hearing loss and deafness</data>
      <data key="d1">concept</data>
      <data key="d2">Impairments affecting the sense of hearing that impact fitness to drive, potentially compensated by vision and attention.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Fitness to drive">
      <data key="d0">Fitness to drive</data>
      <data key="d1">concept</data>
      <data key="d2">The capability to operate a vehicle safely, which is affected by hearing loss and deafness.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Visual impairment">
      <data key="d0">Visual impairment</data>
      <data key="d1">concept</data>
      <data key="d2">An impairment affecting the sense of sight that may coexist with hearing loss and deafness.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Mobility impairment">
      <data key="d0">Mobility impairment</data>
      <data key="d1">concept</data>
      <data key="d2">An impairment affecting physical movement that may coexist with hearing loss and deafness.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Cognitive impairment">
      <data key="d0">Cognitive impairment</data>
      <data key="d1">concept</data>
      <data key="d2">An impairment affecting mental processes that may coexist with hearing loss and deafness, particularly in older people.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Older people">
      <data key="d0">Older people</data>
      <data key="d1">person</data>
      <data key="d2">A demographic group noted for having a higher likelihood of experiencing multiple impairments including hearing loss and cognitive impairment.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Part A 2.2.8. Multiple medical conditions">
      <data key="d0">Part A 2.2.8. Multiple medical conditions</data>
      <data key="d1">content</data>
      <data key="d2">A guidance document referenced for assessing individuals with multiple medical conditions.</data>
      <data key="d3">AFTD2022-EXP-ac9c0c76b5ead534-chunk-000</data>
      <data key="d4">AFTD2022-EXP-ac9c0c76b5ead534</data>
      <data key="d5">1792687354</data>
      <data key="d6" />
    </node>
    <node id="Hearing Loss">
      <data key="d0">Hearing Loss</data>
      <data key="d1">concept</data>
      <data key="d2">A condition characterized by reduced ability to hear auditory cues, which may be compensated for through increased caution and reliance on visual or tactile sensations.&lt;SEP&gt;A condition that may affect driving ability but does not necessarily impact the capacity for responsiveness to critical events, though it complicates reliance on vision alone.&lt;SEP&gt;A condition characterized by a reduction in the ability to hear sounds.&lt;SEP&gt;A condition characterized by a reduction in the ability to hear sounds, measured quantitatively in decibels (dB).</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000&lt;SEP&gt;AFTD2022-EXP-e69686bd8111b385-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-001-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5&lt;SEP&gt;AFTD2022-EXP-e69686bd8111b385&lt;SEP&gt;AFTD2022-HEAR-COM-001&lt;SEP&gt;AFTD2022-HEAR-COM-002</data>
      <data key="d5">1792687436</data>
      <data key="d6" />
    </node>
    <node id="Driving Safely">
      <data key="d0">Driving Safely</data>
      <data key="d1">concept</data>
      <data key="d2">The practice of operating a motor vehicle in a manner that minimizes the risk of accidents and ensures compliance with traffic regulations.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Motor Vehicle Crash Risk">
      <data key="d0">Motor Vehicle Crash Risk</data>
      <data key="d1">concept</data>
      <data key="d2">The probability or likelihood of a collision occurring involving a motor vehicle, often influenced by driver perception and reaction capabilities.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Visual Cues">
      <data key="d0">Visual Cues</data>
      <data key="d1">concept</data>
      <data key="d2">Information conveyed through sight that assists drivers in perceiving their environment, such as traffic signals or road signs.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Vibrations">
      <data key="d0">Vibrations</data>
      <data key="d1">concept</data>
      <data key="d2">Physical oscillations transmitted through the vehicle structure that can alert a driver to mechanical issues or environmental events.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Functional Hearing">
      <data key="d0">Functional Hearing</data>
      <data key="d1">concept</data>
      <data key="d2">The effective use of auditory capabilities within the specific context of driving tasks, including sensing alarms and vehicle status indicators.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Railway Crossings">
      <data key="d0">Railway Crossings</data>
      <data key="d1">location</data>
      <data key="d2">Points where a road intersects with a railway track, requiring drivers to be alert for approaching trains.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="First Responder Sirens">
      <data key="d0">First Responder Sirens</data>
      <data key="d1">artifact</data>
      <data key="d2">Auditory warning devices used by emergency vehicles to signal urgency and demand immediate attention from traffic.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Vehicle Technology Systems">
      <data key="d0">Vehicle Technology Systems</data>
      <data key="d1">organization</data>
      <data key="d2">Integrated electronic systems within modern vehicles designed to monitor performance, safety, and provide alerts to the driver.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Sound Alerts">
      <data key="d0">Sound Alerts</data>
      <data key="d1">artifact</data>
      <data key="d2">Auditory notifications generated by vehicle technology systems to warn drivers of potential hazards or system malfunctions.</data>
      <data key="d3">AFTD2022-EXP-cc5b5152249058a5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-cc5b5152249058a5</data>
      <data key="d5">1792687367</data>
      <data key="d6" />
    </node>
    <node id="Farmer">
      <data key="d0">Farmer</data>
      <data key="d1">person</data>
      <data key="d2">An individual requiring a commercial vehicle licence for the occasional use of heavy vehicles.</data>
      <data key="d3">AFTD2022-EXP-d83c4a25c127adee-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d83c4a25c127adee</data>
      <data key="d5">1792687377</data>
      <data key="d6" />
    </node>
    <node id="Interstate Multiple Combination Vehicle Driver">
      <data key="d0">Interstate Multiple Combination Vehicle Driver</data>
      <data key="d1">person</data>
      <data key="d2">A driver whose licence status differs from that of a farmer due to the nature of their driving task.</data>
      <data key="d3">AFTD2022-EXP-d83c4a25c127adee-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d83c4a25c127adee</data>
      <data key="d5">1792687377</data>
      <data key="d6" />
    </node>
    <node id="Examining Health Professional">
      <data key="d0">Examining Health Professional</data>
      <data key="d1">person</data>
      <data key="d2">The individual responsible for examining persons and providing advice to the driver licensing authority regarding medical conditions.</data>
      <data key="d3">AFTD2022-EXP-d83c4a25c127adee-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d83c4a25c127adee</data>
      <data key="d5">1792687377</data>
      <data key="d6" />
    </node>
    <node id="Patient">
      <data key="d0">Patient</data>
      <data key="d1">person</data>
      <data key="d2">An individual whose condition may affect their ability to drive and who has a legal obligation to notify authorities.</data>
      <data key="d3">AFTD2022-EXP-d83c4a25c127adee-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d83c4a25c127adee</data>
      <data key="d5">1792687377</data>
      <data key="d6" />
    </node>
    <node id="Conditional Licence">
      <data key="d0">Conditional Licence</data>
      <data key="d1">content</data>
      <data key="d2">A type of licence granted by the driver licensing authority that takes into account both the nature of the driving task and the medical condition.&lt;SEP&gt;A driving license granted under specific conditions for individuals who cannot meet standard hearing requirements but are eligible to drive.&lt;SEP&gt;A type of driving license that may be issued by the authority, subject to conditions and periodic reviews.&lt;SEP&gt;A type of driving license issued subject to specific conditions and periodic review.</data>
      <data key="d3">AFTD2022-EXP-d83c4a25c127adee-chunk-000&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d83c4a25c127adee&lt;SEP&gt;AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="Hearing Aid">
      <data key="d0">Hearing Aid</data>
      <data key="d1">artifact</data>
      <data key="d2">A device used to amplify sound for individuals with hearing loss, which may cause driver distraction if noise levels are too high.&lt;SEP&gt;A device used to assist individuals with hearing impairment; its effectiveness is assessed regarding driving standards.&lt;SEP&gt;A device used to assist individuals with hearing impairment.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="ENT Specialist">
      <data key="d0">ENT Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical professional specializing in ear, nose, and throat conditions who can assess a person's eligibility for a conditional licence.&lt;SEP&gt;A medical professional specializing in ear, nose, and throat conditions who provides information relevant to driving assessments.&lt;SEP&gt;A medical professional specializing in ear, nose, and throat conditions who provides information regarding hearing health.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="Medical History">
      <data key="d0">Medical History</data>
      <data key="d1">data</data>
      <data key="d2">Past health records, such as childhood deafness, which may indicate good adaptation to hearing loss and influence driving eligibility.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Driving Record">
      <data key="d0">Driving Record</data>
      <data key="d1">data</data>
      <data key="d2">A history of a person's past and present driving behavior, including incidents before and after the onset of hearing loss.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Driving Task">
      <data key="d0">Driving Task</data>
      <data key="d1">concept</data>
      <data key="d2">The specific requirements of operating a vehicle, including the type of vehicle, road conditions, and distances to be traveled.&lt;SEP&gt;The specific nature of the activity being performed by a driver, which is considered when evaluating fitness to drive.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003</data>
      <data key="d5">1792687453</data>
      <data key="d6" />
    </node>
    <node id="Vehicle">
      <data key="d0">Vehicle</data>
      <data key="d1">artifact</data>
      <data key="d2">A mode of transportation such as a truck or bus, whose characteristics impact the driving task and safety requirements.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Driving Cab">
      <data key="d0">Driving Cab</data>
      <data key="d1">location</data>
      <data key="d2">The interior space of a vehicle where the driver sits, including its ergonomics and available assistive devices.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Assistive Device">
      <data key="d0">Assistive Device</data>
      <data key="d1">artifact</data>
      <data key="d2">Tools like mirrors or GPS systems designed to aid the driver in overcoming sensory impairments.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Vision Impairment">
      <data key="d0">Vision Impairment</data>
      <data key="d1">concept</data>
      <data key="d2">A medical condition affecting sight that may occur concomitantly with hearing loss and impacts driving ability.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d5">1792687404</data>
      <data key="d6" />
    </node>
    <node id="Practical Driver Assessment">
      <data key="d0">Practical Driver Assessment</data>
      <data key="d1">event</data>
      <data key="d2">A hands-on evaluation of a person's ability to operate a vehicle safely, often required for conditional licensing.&lt;SEP&gt;A hands-on evaluation required in some cases to determine if an individual meets the standards for driving without a hearing aid.&lt;SEP&gt;An evaluation process to determine a driver's ability to operate a vehicle safely.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="Noise Amplification">
      <data key="d0">Noise Amplification</data>
      <data key="d1">concept</data>
      <data key="d2">The increase in sound levels caused by hearing aids, which can lead to driver distraction and warrant further assessment.&lt;SEP&gt;The increase in sound levels resulting from wearing hearing aids, which can cause driver distraction.&lt;SEP&gt;The increase in sound levels that can occur when wearing hearing aids, potentially causing distraction.</data>
      <data key="d3">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3e1cd7604e64e7e&lt;SEP&gt;AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d5">1792687463</data>
      <data key="d6" />
    </node>
    <node id="Commercial Vehicle Drivers">
      <data key="d0">Commercial Vehicle Drivers</data>
      <data key="d1">person</data>
      <data key="d2">Drivers of commercial vehicles who require specific safety capacities regarding responsiveness to critical events and environmental situations.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Sirens">
      <data key="d0">Sirens</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Auditory signals representing emergency situations that drivers must respond to.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Rail Crossings">
      <data key="d0">Rail Crossings</data>
      <data key="d1">location</data>
      <data key="d2">Environmental situations involving trains where auditory cues are critical for safety.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Emergency Signals">
      <data key="d0">Emergency Signals</data>
      <data key="d1">concept</data>
      <data key="d2">Auditory or visual warnings indicating urgent conditions that require immediate driver response.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Commercial Vehicle Cabin">
      <data key="d0">Commercial Vehicle Cabin</data>
      <data key="d1">location</data>
      <data key="d2">The internal environment of a commercial vehicle that imposes additional attentional, workload, and visual demands on drivers.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Vision">
      <data key="d0">Vision</data>
      <data key="d1">concept</data>
      <data key="d2">The sensory modality used to monitor the external environment, which may be insufficient to compensate for hearing loss in commercial vehicle contexts.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Communication Systems">
      <data key="d0">Communication Systems</data>
      <data key="d1">artifact</data>
      <data key="d2">Digital or mechanical tools within the cabin used by drivers for interaction and information exchange.</data>
      <data key="d3">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d5">1792687420</data>
      <data key="d6" />
    </node>
    <node id="Compliance">
      <data key="d0">Compliance</data>
      <data key="d1">concept</data>
      <data key="d2">The adherence to a standard that requires clinical assessment.</data>
      <data key="d3">AFTD2022-HEAR-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-HEAR-COM-001</data>
      <data key="d5">1792687428</data>
      <data key="d6" />
    </node>
    <node id="Standard">
      <data key="d0">Standard</data>
      <data key="d1">content</data>
      <data key="d2">A set of guidelines or requirements that must be followed and clinically assessed.</data>
      <data key="d3">AFTD2022-HEAR-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-HEAR-COM-001</data>
      <data key="d5">1792687428</data>
      <data key="d6" />
    </node>
    <node id="Clinical Assessment">
      <data key="d0">Clinical Assessment</data>
      <data key="d1">method</data>
      <data key="d2">An initial evaluation process used to determine if hearing loss is possible.</data>
      <data key="d3">AFTD2022-HEAR-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-HEAR-COM-001</data>
      <data key="d5">1792687428</data>
      <data key="d6" />
    </node>
    <node id="Unconditional Licence">
      <data key="d0">Unconditional Licence</data>
      <data key="d1">artifact</data>
      <data key="d2">A type of official authorization or permit that requires the holder to meet specific health criteria, including adequate hearing ability.</data>
      <data key="d3">AFTD2022-HEAR-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-HEAR-COM-002</data>
      <data key="d5">1792687436</data>
      <data key="d6" />
    </node>
    <node id="Better Ear">
      <data key="d0">Better Ear</data>
      <data key="d1">location</data>
      <data key="d2">The ear with superior auditory function compared to the other ear, used as the reference point for assessing hearing loss severity.</data>
