    <node id="Medmont binocular VF">
      <data key="d0">Medmont binocular VF</data>
      <data key="d1">artifact</data>
      <data key="d2">An alternative device capable of producing a level map mode printout equivalent to the standard Esterman chart.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Treating optometrist">
      <data key="d0">Treating optometrist</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional responsible for determining whether a patient should wear corrective lenses during testing.&lt;SEP&gt;A medical professional who assesses and certifies a person's vision status according to specific standards.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000&lt;SEP&gt;AFTD2022-EXP-a09b64ac70a92828-chunk-000</data>
