    </node>
    <node id="Neurological Conditions">
      <data key="d0">Neurological Conditions</data>
      <data key="d1">concept</data>
      <data key="d2">Medical conditions affecting the nervous system, including stroke, which require integrated assessment for driving.&lt;SEP&gt;Conditions that may affect vision, referenced in section 6.3 as other neurological and neurodevelopmental conditions.</data>
      <data key="d3">AFTD2022-EXP-db731186cdb786e3-chunk-000&lt;SEP&gt;AFTD2022-EXP-e2669d1b502303f5-chunk-000</data>
