      <data key="d12">1792687019</data>
      <data key="d13" />
    </edge>
    <edge source="Diabetes" target="Vision">
      <data key="d7">1.0</data>
      <data key="d8">Diabetes causes end-organ effects that impact vision, which is a relevant function for driving.</data>
      <data key="d9">driving,end-organ effects,impairment</data>
