{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "default": null,
          "title": "Value"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "present",
            "unknown",
            "conflicting",
            "requires_confirmation"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/TextSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "method": {
          "default": "not_recorded",
          "title": "Method",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "title": "Fact",
      "type": "object"
    },
    "RAGRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "request_type": {
          "enum": [
            "triggered_rule_evidence",
            "missing_information_guidance"
          ],
          "title": "Request Type",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "subcondition": {
          "title": "Subcondition",
          "type": "string"
        },
        "licence_context": {
          "const": "commercial",
          "default": "commercial",
          "title": "Licence Context",
          "type": "string"
        },
        "rag_query_key": {
          "title": "Rag Query Key",
          "type": "string"
        },
        "ambiguity_reasons": {
          "items": {
            "enum": [
              "missing_fact",
              "conflicting_fact",
              "requires_confirmation",
              "cross_chapter_condition"
            ],
            "type": "string"
          },
          "title": "Ambiguity Reasons",
          "type": "array"
        },
        "fact_context": {
          "additionalProperties": {
            "enum": [
              "unknown",
              "conflicting",
              "requires_confirmation"
            ],
            "type": "string"
          },
          "title": "Fact Context",
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "request_type",
        "rule_id",
        "source_ids",
        "category",
        "subcondition",
        "rag_query_key"
      ],
      "title": "RAGRequest",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "pdf_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page"
        }
      },
      "required": [
        "start",
        "end",
        "quote",
        "line_start",
        "line_end"
      ],
      "title": "TextSpan",
      "type": "object"
    },
    "WorkflowRoute": {
      "enum": [
        "fast_path",
        "rag_review",
        "missing_information",
        "human_review"
      ],
      "title": "WorkflowRoute",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Minimal immutable envelope accepted by retrieval.",
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "red_flag_result_sha256": {
      "title": "Red Flag Result Sha256",
      "type": "string"
    },
    "ruleset_sha256": {
      "title": "Ruleset Sha256",
      "type": "string"
    },
    "guideline_version": {
      "const": "AP-G56-22",
      "default": "AP-G56-22",
      "title": "Guideline Version",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/WorkflowRoute"
    },
    "rag_requests": {
      "items": {
        "$ref": "#/$defs/RAGRequest"
      },
      "title": "Rag Requests",
      "type": "array"
    },
    "indicator_context": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Fact"
        },
        "type": "object"
      },
      "title": "Indicator Context",
      "type": "object"
    },
    "narrative_context": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/TextSpan"
        },
        "type": "array"
      },
      "title": "Narrative Context",
      "type": "object"
    },
    "narrative_source_text_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narrative Source Text Sha256"
    }
  },
  "required": [
    "result_id",
    "case_id",
    "red_flag_result_sha256",
    "ruleset_sha256",
    "route",
    "rag_requests"
  ],
  "title": "RAGInput",
  "type": "object"
}
