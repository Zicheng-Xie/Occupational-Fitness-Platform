      <data key="d13" />
    </edge>
    <edge source="Hypoglycaemia" target="Severe hypoglycaemic event">
      <data key="d7">1.0</data>
      <data key="d8">A severe hypoglycaemic event is distinguished from mild hypoglycaemic events.</data>
      <data key="d9">classification,distinction</data>
      <data key="d10">AFTD2022-EXP-0f4bda9270b6616d-chunk-000</data>
      <data key="d11">AFTD2022-EXP-0f4bda9270b6616d</data>
      <data key="d12">1792687005</data>
      <data key="d13" />
    </edge>
    <edge source="Hypoglycaemia" target="Mild hypoglycaemic events">
      <data key="d7">1.0</data>
      <data key="d8">Mild hypoglycaemic events are characterized by symptoms such as sweating, tremulousness, hunger, and tingling around the mouth.</data>
