              "end_row_offset_idx": 3,
              "start_col_offset_idx": 0,
              "end_col_offset_idx": 1,
              "text": "Visual fields Refer to section 10.2.2. Visual fields.",
              "column_header": false,
              "row_header": false,
              "row_section": false,
              "fillable": false
            },
            {
              "bbox": {
                "l": 151.31371986865997,
