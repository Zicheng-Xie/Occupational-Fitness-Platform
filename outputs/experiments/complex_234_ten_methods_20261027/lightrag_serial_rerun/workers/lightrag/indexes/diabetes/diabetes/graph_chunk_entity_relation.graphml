      <data key="d0">Insulin</data>
      <data key="d1">artifact</data>
      <data key="d2">A medication used to treat diabetes, which can cause hypoglycaemic events in treated persons.&lt;SEP&gt;A substance associated with the context of severe hypoglycaemic episodes mentioned in the scoring criteria.&lt;SEP&gt;A specific type of glucose-lowering agent used in medical treatment.</data>
      <data key="d3">AFTD2022-EXP-0f4bda9270b6616d-chunk-000&lt;SEP&gt;AFTD2022-EXP-5681044dd2d96a1d-chunk-000&lt;SEP&gt;AFTD2022-EXP-758d10f29d7875e9-chunk-000</data>
