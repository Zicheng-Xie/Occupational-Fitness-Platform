  "regions": [
    {
      "kind": "text",
      "native_ref": "#/texts/395",
      "text": "At present, there is insufficient information from human factors and safety research of drivers using these devices to set standards for bioptics. As such, and due to the increased risk associated with commercial vehicle driving (refer to Part A section 4.1. Medical standards for private and commercial vehicle drivers), these devices should not be used to meet the visual acuity standards for commercial vehicles. For private vehicle drivers, the driver licensing authority may consider information from an assessment performed by an ophthalmologist or optometrist when making its licensing decision.",
      "bbox_top_left": [
        56.6929,
        64.35609999999997,
        285.70189999999997,
        88.76024365152921
      ],
      "native_provenance": {
