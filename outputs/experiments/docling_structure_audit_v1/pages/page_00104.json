        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/145",
      "text": "checking the blood glucose levels 15 minutes or more after the hypoglycaemia has been treated and ensuring it is above 5 mmol/L",
      "bbox_top_left": [
