    <node id="Physiological Diplopia">
      <data key="d0">Physiological Diplopia</data>
      <data key="d1">concept</data>
      <data key="d2">A specific type of diplopia that is considered normal or expected in certain contexts and does not disqualify a person from holding a licence.</data>
      <data key="d3">AFTD2022-VIS-COM-007-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-007</data>
      <data key="d5">1792761769</data>
      <data key="d6" />
    </node>
    <node id="Central Fixation">
      <data key="d0">Central Fixation</data>
      <data key="d1">concept</data>
