    <edge source="Insulin-Treated Diabetes" target="Unconditional Licence">
      <data key="d7">1.0</data>
      <data key="d8">A person with insulin-treated diabetes is not fit to hold an unconditional licence.</data>
      <data key="d9">eligibility,fitness,medical condition</data>
      <data key="d10">AFTD2022-EXP-e3ca8efaf3d71461-chunk-000</data>
