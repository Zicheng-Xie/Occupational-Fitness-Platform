          "b": 766.8890428571428,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          12
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/1",
      "text": "1.1. Relevance to the driving task",
      "bbox_top_left": [
        56.6929,
        113.29859999999996,
        242.30889999999994,
        152.21665714285712
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 728.5914,
          "r": 242.30889999999994,
          "b": 689.6733428571429,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          34
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/2",
      "text": "For the purposes of this standard, the term 'blackout' means a transient impairment or loss of consciousness. Loss of consciousness is clearly incompatible with safe driving. The evidence for crash risk associated with various causes of blackout is discussed in the relevant chapters. This chapter provides guidance regarding the general management of blackouts, with cross-reference to relevant chapters as per Figure 6. Management of blackouts and driving.",
      "bbox_top_left": [
        56.6929,
        169.35609999999997,
        272.25989999999996,
        329.00503697868396
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 672.5339,
          "r": 272.25989999999996,
          "b": 512.884963021316,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          458
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/3",
      "text": "1.2. General assessment and management guidelines",
      "bbox_top_left": [
        56.6929,
        351.89099999999996,
        273.4831000000001,
        412.40905714285714
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 489.999,
          "r": 273.4831000000001,
          "b": 429.48094285714285,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          49
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/4",
      "text": "1.2.1. General considerations 1-4",
      "bbox_top_left": [
        56.6929,
        436.587046,
        243.068078,
        449.6355652455977
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 405.302954,
          "r": 243.068078,
          "b": 392.25443475440227,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          33
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/5",
      "text": "Blackouts may occur due to a range of mechanisms including:",
      "bbox_top_left": [
        56.6929,
        469.35609999999997,
        239.14989999999992,
        493.76024365152915
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 372.5339,
          "r": 239.14989999999992,
          "b": 348.12975634847083,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          59
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/6",
      "text": "vasovagal syncope or 'faint', which accounts for more than 50 per cent of blackouts and may be due to factors such as hot weather, emotion or venepuncture but may also be due to more serious causes that may recur",
      "bbox_top_left": [
        56.6929,
        499.35609999999997,
        283.73469999999986,
        568.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 342.5339,
          "r": 283.73469999999986,
          "b": 273.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          214
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/7",
      "text": "syncope due to other cardiovascular causes such as structural heart disease, arrhythmias or vascular disease",
      "bbox_top_left": [
        56.6929,
        574.3561,
        284.1989,
        613.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 267.5339,
          "r": 284.1989,
          "b": 228.12975634847078,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          110
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/8",
      "text": "epileptic seizure, which accounts for less than 10 per cent of blackouts",
      "bbox_top_left": [
        56.6929,
        619.3561,
        268.0266999999999,
        643.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 222.53390000000002,
          "r": 268.0266999999999,
          "b": 198.12975634847078,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          74
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/9",
      "text": "other causes including metabolic causes (e.g. hypoglycaemia), drug intoxication or a sleep disorder.",
      "bbox_top_left": [
        56.6929,
        649.3561,
        276.39770000000004,
        688.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 192.53390000000002,
          "r": 276.39770000000004,
          "b": 153.12975634847078,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          102
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/10",
      "text": "Determination of the mechanism of a blackout may be straightforward based on history, investigations and specialist referral, and the person may be managed as per the appropriate chapter. Alternatively, it may require extensive cardiovascular and neurological investigations and referral to several specialists. People should be advised not to drive until the mechanism is ascertained and the corresponding standard met.",
      "bbox_top_left": [
        56.6929,
        709.3561,
        284.10689999999994,
        778.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 56.6929,
          "t": 132.53390000000002,
          "r": 284.10689999999994,
          "b": 63.12975634847078,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          227
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/10",
      "text": "Determination of the mechanism of a blackout may be straightforward based on history, investigations and specialist referral, and the person may be managed as per the appropriate chapter. Alternatively, it may require extensive cardiovascular and neurological investigations and referral to several specialists. People should be advised not to drive until the mechanism is ascertained and the corresponding standard met.",
      "bbox_top_left": [
        307.559,
        124.35609999999997,
        536.9167,
        178.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 307.559,
          "t": 717.5339,
          "r": 536.9167,
          "b": 663.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          228,
          420
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/11",
      "text": "Some drivers may attribute a crash or driving mishap to a 'blackout' to excuse an event that occurred for some other reason such as inattention or distraction (e.g. a mobile phone conversation). There will also be a small proportion of cases in which a clear cause cannot be established.",
      "bbox_top_left": [
        307.559,
        199.35609999999997,
        521.4407999999999,
        298.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 307.559,
          "t": 642.5339,
          "r": 521.4407999999999,
          "b": 543.1297563484708,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          287
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/12",
      "text": "1.2.2. Vasovagal syncope 5",
      "bbox_top_left": [
        307.559,
        316.587046,
        467.04278999999997,
        329.6355652455977
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 307.559,
          "t": 525.302954,
          "r": 467.04278999999997,
          "b": 512.2544347544023,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          26
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/13",
      "text": "The most common cause of transient loss of consciousness is vasovagal syncope ('fainting'). Where this has been triggered by a well-defined provoking factor or a situation that is unlikely to recur while driving (e.g. prolonged standing, venepuncture or emotional situation), it is not necessary to restrict driving. However, vasovagal syncope may also result from other causes that are not so benign. In such cases, fitness to drive should be assessed according to the cardiovascular conditions standards for syncope (refer to section 2. Cardiovascular conditions).",
      "bbox_top_left": [
        307.559,
        349.35609999999997,
        538.4567000000001,
        524.0050369786838
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 307.559,
          "t": 492.5339,
          "r": 538.4567000000001,
          "b": 317.88496302131614,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          566
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/14",
      "text": "1.2.3. Blackouts due to medical causes not covered in the standards",
      "bbox_top_left": [
        307.5591,
        542.3551,
        531.3911,
        569.6355652455977
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 307.5591,
          "t": 299.5349,
          "r": 531.3911,
          "b": 272.25443475440227,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          67
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/15",
      "text": "If the cause of the blackout is determined to be a medical condition not covered in the standards, then first principles regarding fitness to drive should be applied (refer to Part A section 2. Assessing fitness to drive - general guidance). Considerations include the likelihood of recurrence of blackout and the treatability of the condition as well as the nature of the driving task. There should also be an appropriate review period. A more stringent approach should be considered for commercial vehicle drivers.",
      "bbox_top_left": [
        307.5591,
        589.3561,
        532.2451000000001,
        763.7602436515292
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
          "l": 307.5591,
          "t": 252.53390000000002,
          "r": 532.2451000000001,
          "b": 78.12975634847078,
          "coord_origin": "BOTTOMLEFT"
        },
        "charspan": [
          0,
          516
        ]
      }
    },
    {
