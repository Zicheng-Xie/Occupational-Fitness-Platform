  "regions": [
    {
      "kind": "text",
      "native_ref": "#/texts/0",
      "text": "1. Blackouts",
      "bbox_top_left": [
        56.6929,
        57.68290000000002,
        176.704,
        75.00095714285715
      ],
      "native_provenance": {
        "page_no": 1,
        "bbox": {
