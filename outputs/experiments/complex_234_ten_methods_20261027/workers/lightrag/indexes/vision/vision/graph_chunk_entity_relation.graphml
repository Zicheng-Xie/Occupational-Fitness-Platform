      <data key="d13" />
    </edge>
    <edge source="Diplopia" target="Optometrist">
      <data key="d7">1.0</data>
      <data key="d8">People suspected of experiencing diplopia should be referred for assessment by an optometrist.</data>
      <data key="d9">assessment,referral</data>
      <data key="d10">AFTD2022-EXP-0fe8bf8cdf4b51c6-chunk-000</data>
