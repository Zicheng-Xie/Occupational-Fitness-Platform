    </node>
    <node id="Retinopathy">
      <data key="d0">Retinopathy</data>
      <data key="d1">concept</data>
      <data key="d2">A condition affecting the retina; its absence determines the frequency of retinal screening.</data>
      <data key="d3">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d6142190f29b7662</data>
      <data key="d5">1792687240</data>
