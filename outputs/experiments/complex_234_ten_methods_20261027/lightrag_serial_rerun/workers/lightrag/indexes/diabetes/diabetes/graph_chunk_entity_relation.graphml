    <edge source="Diabetes" target="Hypoglycaemic agents">
      <data key="d7">1.0</data>
      <data key="d8">Persons with diabetes treated with some hypoglycaemic agents may experience common occurrences of mild hypoglycaemic events.</data>
      <data key="d9">medication,treatment</data>
      <data key="d10">AFTD2022-EXP-0f4bda9270b6616d-chunk-000</data>
