      <data key="d1">artifact</data>
      <data key="d2">Traffic or road lighting devices that drivers must respond to, potentially affected by color vision deficiencies.</data>
      <data key="d3">AFTD2022-EXP-e8267bf4145306c0-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e8267bf4145306c0</data>
      <data key="d5">1792761692</data>
      <data key="d6" />
    </node>
    <node id="Normal Road Rules and Conditions">
      <data key="d0">Normal Road Rules and Conditions</data>
      <data key="d1">concept</data>
      <data key="d2">The standard regulatory framework and environmental circumstances within which the current driving standards apply.</data>
      <data key="d3">AFTD2022-EXP-e8267bf4145306c0-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e8267bf4145306c0</data>
      <data key="d5">1792761692</data>
      <data key="d6" />
    </node>
    <node id="Risk Assessment">
      <data key="d0">Risk Assessment</data>
      <data key="d1">method</data>
      <data key="d2">A process used to justify implementing a color vision requirement for specific driving tasks based on potential hazards.</data>
      <data key="d3">AFTD2022-EXP-e8267bf4145306c0-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e8267bf4145306c0</data>
      <data key="d5">1792761692</data>
      <data key="d6" />
    </node>
    <node id="Better Eye">
      <data key="d0">Better Eye</data>
      <data key="d1">location</data>
      <data key="d2">The eye with superior visual acuity among a pair, used as a reference point for assessing fitness.</data>
      <data key="d3">AFTD2022-VIS-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-002</data>
      <data key="d5">1792761702</data>
      <data key="d6" />
    </node>
    <node id="Either Eye">
      <data key="d0">Either Eye</data>
      <data key="d1">location</data>
      <data key="d2">Refers to any of the two eyes when evaluating uncorrected visual acuity against specific thresholds.</data>
      <data key="d3">AFTD2022-VIS-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-002</data>
      <data key="d5">1792761702</data>
      <data key="d6" />
    </node>
    <node id="Six over Nine">
      <data key="d0">Six over Nine</data>
      <data key="d1">data</data>
      <data key="d2">A visual acuity measurement standard represented as 6/9, indicating a threshold for fitness.</data>
      <data key="d3">AFTD2022-VIS-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-002</data>
      <data key="d5">1792761702</data>
      <data key="d6" />
    </node>
    <node id="Six over Eighteen">
      <data key="d0">Six over Eighteen</data>
      <data key="d1">data</data>
      <data key="d2">A visual acuity measurement standard represented as 6/18, indicating a lower threshold for fitness.</data>
      <data key="d3">AFTD2022-VIS-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-002</data>
      <data key="d5">1792761702</data>
      <data key="d6" />
    </node>
    <node id="Corrective Lenses">
      <data key="d0">Corrective Lenses</data>
      <data key="d1">artifact</data>
      <data key="d2">Eyewear used to improve vision, which may be required to meet the standard for a conditional license.</data>
      <data key="d3">AFTD2022-VIS-COM-003-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-003</data>
      <data key="d5">1792761717</data>
      <data key="d6" />
    </node>
    <node id="Driving Task">
      <data key="d0">Driving Task</data>
      <data key="d3">AFTD2022-VIS-COM-003-chunk-000</data>
      <data key="d2">The authority takes into account the nature of the driving task when evaluating applicants.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">AFTD2022-VIS-COM-003</data>
      <data key="d5">1792761717</data>
      <data key="d6" />
