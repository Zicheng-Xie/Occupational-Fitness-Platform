    </edge>
    <edge source="Commercial Vehicle Drivers" target="Commercial Vehicle Cabin">
      <data key="d7">1.0</data>
      <data key="d8">The internal cabin places additional attentional, workload, and visual demands on drivers for tasks such as checking displays and using communication systems.</data>
      <data key="d9">Attention,Visual Demands,Workload</data>
      <data key="d10">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
