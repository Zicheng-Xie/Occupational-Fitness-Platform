      <data key="d3">AFTD2022-VIS-COM-007-chunk-000</data>
      <data key="d4">AFTD2022-VIS-COM-007</data>
      <data key="d5">1792761769</data>
      <data key="d6" />
    </node>
    <edge source="Visual field impairment" target="Confrontation test">
      <data key="d7">1.0</data>
      <data key="d8">The confrontation test is used to screen for visual field defects only when there is no clinical indication of such impairment or a progressive eye condition.</data>
      <data key="d9">indication,screening</data>
