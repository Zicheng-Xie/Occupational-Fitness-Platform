    <node id="Visual field impairment">
      <data key="d0">Visual field impairment</data>
      <data key="d1">concept</data>
      <data key="d2">A condition characterized by defects in the visual field that may be progressive or clinically indicated.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Progressive eye condition">
      <data key="d0">Progressive eye condition</data>
      <data key="d1">concept</data>
      <data key="d2">An ocular disorder that worsens over time, requiring specific assessment protocols.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Confrontation test">
      <data key="d0">Confrontation test</data>
      <data key="d1">method</data>
      <data key="d2">An inexact screening method used to detect visual field defects when no clinical indication of impairment or progressive condition exists.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Formal perimetry-based assessment">
      <data key="d0">Formal perimetry-based assessment</data>
      <data key="d1">method</data>
      <data key="d2">A rigorous evaluation procedure required for individuals with suspected or confirmed visual field defects.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Monocular automated static perimetry">
      <data key="d0">Monocular automated static perimetry</data>
      <data key="d1">method</data>
      <data key="d2">The minimum baseline standard for visual field assessments, used to confirm compliance when no defect is detected.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Binocular Esterman visual field">
      <data key="d0">Binocular Esterman visual field</data>
      <data key="d1">method</data>
      <data key="d2">A specific assessment protocol required for subjects with significant field defects or progressive eye conditions.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
      <data key="d6" />
    </node>
    <node id="Humphrey visual field analyser">
      <data key="d0">Humphrey visual field analyser</data>
      <data key="d1">artifact</data>
      <data key="d2">A device classically used to administer the binocular Esterman visual field test.</data>
      <data key="d3">AFTD2022-EXP-072f14c5d1083124-chunk-000</data>
      <data key="d4">AFTD2022-EXP-072f14c5d1083124</data>
      <data key="d5">1792761465</data>
