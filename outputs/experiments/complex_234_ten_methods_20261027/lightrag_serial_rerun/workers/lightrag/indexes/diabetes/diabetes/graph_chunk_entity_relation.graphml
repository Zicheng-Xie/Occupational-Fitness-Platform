      <data key="d5">1792687210</data>
      <data key="d6" />
    </node>
    <node id="Hypoglycaemic agents">
      <data key="d0">Hypoglycaemic agents</data>
      <data key="d1">artifact</data>
      <data key="d2">Medications that may cause hypoglycaemic events in persons with diabetes.</data>
      <data key="d3">AFTD2022-EXP-0f4bda9270b6616d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-0f4bda9270b6616d</data>
      <data key="d5">1792687005</data>
      <data key="d6" />
    </node>
    <node id="Non-adherence to medication">
      <data key="d0">Non-adherence to medication</data>
      <data key="d1">concept</data>
      <data key="d2">A potential cause of hypoglycaemia resulting from failure to follow prescribed medication regimens.</data>
      <data key="d3">AFTD2022-EXP-0f4bda9270b6616d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-0f4bda9270b6616d</data>
      <data key="d5">1792687005</data>
      <data key="d6" />
    </node>
    <node id="Alteration to medication">
      <data key="d0">Alteration to medication</data>
      <data key="d1">concept</data>
      <data key="d2">A potential cause of hypoglycaemia involving changes made to the administration or dosage of medication.</data>
      <data key="d3">AFTD2022-EXP-0f4bda9270b6616d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-0f4bda9270b6616d</data>
