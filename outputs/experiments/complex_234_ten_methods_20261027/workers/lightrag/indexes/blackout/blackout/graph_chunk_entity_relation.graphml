      <data key="d13" />
    </edge>
    <edge source="Fitness to Drive Assessment" target="Section 1.3 Medical Standards for Licensing">
      <data key="d7">1.0</data>
      <data key="d8">The assessment of fitness to drive is conducted according to the standards found in Section 1.3 Medical Standards for Licensing.</data>
      <data key="d9">regulatory reference,standards</data>
      <data key="d10">AFTD2022-EXP-3a8e08652c83a2d0-chunk-000</data>
      <data key="d11">AFTD2022-EXP-3a8e08652c83a2d0</data>
