{
  "$defs": {
    "AssessmentContext": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "const": "Austroads",
          "default": "Austroads",
          "title": "Framework",
          "type": "string"
        },
        "licence_context": {
          "const": "commercial",
          "default": "commercial",
          "title": "Licence Context",
          "type": "string"
        },
        "job_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Title"
        },
        "modules_requested": {
          "items": {
            "type": "string"
          },
          "title": "Modules Requested",
          "type": "array"
        }
      },
      "required": [
        "modules_requested"
      ],
      "title": "AssessmentContext",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "default": null,
          "title": "Value"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "present",
            "unknown",
            "conflicting",
            "requires_confirmation"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/TextSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "method": {
          "default": "not_recorded",
          "title": "Method",
          "type": "string"
        },
        "derived_from": {
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "title": "Fact",
      "type": "object"
    },
    "MissingInformation": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "status": {
          "enum": [
            "unknown",
            "conflicting",
            "requires_confirmation"
          ],
          "title": "Status",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required_by_rule_id": {
          "title": "Required By Rule Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "source_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence",
          "type": "array"
        },
        "rag_query_key": {
          "title": "Rag Query Key",
          "type": "string"
        }
      },
      "required": [
        "field",
        "status",
        "category",
        "reason",
        "required_by_rule_id",
        "source_ids",
        "source_evidence",
        "rag_query_key"
      ],
      "title": "MissingInformation",
      "type": "object"
    },
    "ModuleAssessment": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "title": "Module",
          "type": "string"
        },
        "assessment_outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "route": {
          "$ref": "#/$defs/WorkflowRoute"
        },
        "triggered_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Triggered Rule Ids",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "module",
        "assessment_outcome",
        "route",
        "triggered_rule_ids",
        "missing_fields"
      ],
      "title": "ModuleAssessment",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "meets_unconditional_standard",
        "may_meet_conditional_standard",
        "temporarily_unfit",
        "does_not_meet_standard",
        "insufficient_information"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ProcessingWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "requires_human_review": {
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProcessingWarning",
      "type": "object"
    },
    "RAGRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "request_type": {
          "enum": [
            "triggered_rule_evidence",
            "missing_information_guidance"
          ],
          "title": "Request Type",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "subcondition": {
          "title": "Subcondition",
          "type": "string"
        },
        "licence_context": {
          "const": "commercial",
          "default": "commercial",
          "title": "Licence Context",
          "type": "string"
        },
        "rag_query_key": {
          "title": "Rag Query Key",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "request_type",
        "rule_id",
        "source_ids",
        "category",
        "subcondition",
        "rag_query_key"
      ],
      "title": "RAGRequest",
      "type": "object"
    },
    "ResultSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "nurse_note",
          "default": "nurse_note",
          "title": "Type",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source_file"
      ],
      "title": "ResultSource",
      "type": "object"
    },
    "RuleEvaluation": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "subcondition": {
          "title": "Subcondition",
          "type": "string"
        },
        "result": {
          "enum": [
            "triggered",
            "not_triggered",
            "unknown",
            "not_applicable"
          ],
          "title": "Result",
          "type": "string"
        },
        "assessment_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "rag_query_key": {
          "title": "Rag Query Key",
          "type": "string"
        },
        "observed_facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Observed Facts",
          "type": "object"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "condition_trace": {
          "additionalProperties": true,
          "title": "Condition Trace",
          "type": "object"
        }
      },
      "required": [
        "rule_id",
        "module",
        "category",
        "subcondition",
        "result",
        "reason",
        "source_ids",
        "rag_query_key"
      ],
      "title": "RuleEvaluation",
      "type": "object"
    },
    "RulesetIdentity": {
      "additionalProperties": false,
      "properties": {
        "ruleset_id": {
          "title": "Ruleset Id",
          "type": "string"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "ruleset_sha256": {
          "title": "Ruleset Sha256",
          "type": "string"
        },
        "guideline_version": {
          "const": "AP-G56-22",
          "default": "AP-G56-22",
          "title": "Guideline Version",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "ruleset_id",
        "ruleset_version",
        "ruleset_sha256",
        "status"
      ],
      "title": "RulesetIdentity",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "pdf_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page"
        }
      },
      "required": [
        "start",
        "end",
        "quote",
        "line_start",
        "line_end"
      ],
      "title": "TextSpan",
      "type": "object"
    },
    "TriggeredRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "subcondition": {
          "title": "Subcondition",
          "type": "string"
        },
        "rule_result": {
          "const": "triggered",
          "default": "triggered",
          "title": "Rule Result",
          "type": "string"
        },
        "assessment_outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "observed_facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Observed Facts",
          "type": "object"
        },
        "source_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence",
          "type": "array"
        },
        "rag_query_key": {
          "title": "Rag Query Key",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "source_ids",
        "category",
        "subcondition",
        "assessment_outcome",
        "reason",
        "observed_facts",
        "source_evidence",
        "rag_query_key"
      ],
      "title": "TriggeredRule",
      "type": "object"
    },
    "WorkflowRoute": {
      "enum": [
        "fast_path",
        "rag_review",
        "missing_information",
        "human_review"
      ],
      "title": "WorkflowRoute",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3.0",
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "case_sha256": {
      "title": "Case Sha256",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ResultSource"
    },
    "assessment_context": {
      "$ref": "#/$defs/AssessmentContext"
    },
    "ruleset": {
      "$ref": "#/$defs/RulesetIdentity"
    },
    "route": {
      "$ref": "#/$defs/WorkflowRoute"
    },
    "assessment_outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "outcome_label": {
      "title": "Outcome Label",
      "type": "string"
    },
    "has_red_flag": {
      "title": "Has Red Flag",
      "type": "boolean"
    },
    "red_flags": {
      "items": {
        "$ref": "#/$defs/TriggeredRule"
      },
      "title": "Red Flags",
      "type": "array"
    },
    "triggered_rules": {
      "items": {
        "$ref": "#/$defs/TriggeredRule"
      },
      "title": "Triggered Rules",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "$ref": "#/$defs/MissingInformation"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/ModuleAssessment"
      },
      "title": "Modules",
      "type": "array"
    },
    "rules_evaluated": {
      "items": {
        "$ref": "#/$defs/RuleEvaluation"
      },
      "title": "Rules Evaluated",
      "type": "array"
    },
    "processing_warnings": {
      "items": {
        "$ref": "#/$defs/ProcessingWarning"
      },
      "title": "Processing Warnings",
      "type": "array"
    },
    "requires_human_review": {
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "rag_requests": {
      "items": {
        "$ref": "#/$defs/RAGRequest"
      },
      "title": "Rag Requests",
      "type": "array"
    },
    "internal_metadata": {
      "additionalProperties": true,
      "title": "Internal Metadata",
      "type": "object"
    }
  },
  "required": [
    "result_id",
    "case_id",
    "case_sha256",
    "source",
    "assessment_context",
    "ruleset",
    "route",
    "assessment_outcome",
    "outcome_label",
    "has_red_flag",
    "red_flags",
    "triggered_rules",
    "missing_information",
    "modules",
    "rules_evaluated",
    "processing_warnings",
    "requires_human_review",
    "rag_requests"
  ],
  "title": "WorkflowRuleResult",
  "type": "object"
}
