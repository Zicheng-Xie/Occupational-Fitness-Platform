      <data key="d13" />
    </edge>
    <edge source="Formal perimetry-based assessment" target="Visual field defect">
      <data key="d7">1.0</data>
      <data key="d8">Any person with a visual field defect or suspected of having one must undergo a formal perimetry-based assessment.</data>
      <data key="d9">evaluation,requirement</data>
