              "row_span": 1,
              "col_span": 1,
              "start_row_offset_idx": 1,
              "end_row_offset_idx": 2,
              "start_col_offset_idx": 1,
              "end_col_offset_idx": 2,
              "text": "Private standards (Drivers of cars, light rigid vehicles or motorcycles unless carrying public passengers or requiring a dangerous goods driver licence - refer to definition in Table 3)",
              "column_header": false,
              "row_header": false,
              "row_section": false,
              "fillable": false
            },
            {
              "bbox": {
                "l": 340.47458547353745,
                "t": 93.79669463634491,
                "r": 520.5574221014977,
                "b": 153.28864803910255,
                "coord_origin": "TOPLEFT"
              },
              "row_span": 1,
              "col_span": 1,
              "start_row_offset_idx": 1,
              "end_row_offset_idx": 2,
              "start_col_offset_idx": 2,
              "end_col_offset_idx": 3,
              "text": "Commercial standards (Drivers of heavy vehicles, public passenger vehicles or requiring a dangerous goods driver licence - refer to definition in Table 3)",
              "column_header": false,
              "row_header": false,
              "row_section": false,
              "fillable": false
            }
