  <graph edgedefault="undirected">
    <node id="High blood pressure">
      <data key="d0">High blood pressure</data>
      <data key="d1">concept</data>
      <data key="d2">A medical condition where blood pressure levels are elevated, often associated with sudden neurological events such as stroke.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Unconditional licence">
      <data key="d0">Unconditional licence</data>
      <data key="d1">content</data>
      <data key="d2">A driving license that allows a person to drive without specific conditions or restrictions.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Conditional licence">
      <data key="d0">Conditional licence</data>
      <data key="d1">content</data>
      <data key="d2">A type of driving license issued with specific requirements, particularly for commercial vehicle drivers, which must be reviewed periodically.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Commercial vehicle driver">
      <data key="d0">Commercial vehicle driver</data>
      <data key="d1">person</data>
      <data key="d2">Individuals who operate vehicles used for business purposes and are subject to specific licensing requirements regarding health and fitness.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Driver licensing authority">
      <data key="d0">Driver licensing authority</data>
      <data key="d1">organization</data>
      <data key="d2">The governmental or official body responsible for issuing and managing driving licenses.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Medical specialist">
      <data key="d0">Medical specialist</data>
      <data key="d1">person</data>
      <data key="d2">A qualified healthcare professional who provides advice on the fitness of drivers to hold conditional licenses.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="General practitioner">
      <data key="d0">General practitioner</data>
      <data key="d1">person</data>
      <data key="d2">A primary care physician who may assess ongoing fitness to drive for high blood pressure cases, subject to mutual agreement with a specialist.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Neurological events">
      <data key="d0">Neurological events</data>
      <data key="d1">concept</data>
      <data key="d2">Medical occurrences such as strokes that can result in sudden incapacity and affect driving ability.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Stroke">
      <data key="d0">Stroke</data>
      <data key="d1">event</data>
      <data key="d2">A specific neurological event caused by a disruption of blood flow to the brain, leading to potential loss of function or consciousness.</data>
      <data key="d3">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d4">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d5">1792686681</data>
      <data key="d6" />
    </node>
    <node id="Commercial Standards">
      <data key="d0">Commercial Standards</data>
      <data key="d1">concept</data>
      <data key="d2">Standards applicable to drivers of heavy vehicles, public passenger vehicles, or those requiring a dangerous goods driver licence.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d5">1792686696</data>
      <data key="d6" />
    </node>
    <node id="Unconditional Licence">
      <data key="d0">Unconditional Licence</data>
      <data key="d1">content</data>
      <data key="d2">A driving licence that is not subject to conditions; a person is not fit to hold this if they have consistently high blood pressure.&lt;SEP&gt;A type of license that requires the holder to meet specific health standards, specifically regarding blood pressure levels.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-001</data>
      <data key="d5">1792686699</data>
      <data key="d6" />
    </node>
    <node id="Conditional Licence">
      <data key="d0">Conditional Licence</data>
      <data key="d1">artifact</data>
      <data key="d2">A driving licence granted by the driver licensing authority subject to annual review and specific medical criteria.&lt;SEP&gt;A driving permit that may be issued subject to annual review, based on criteria regarding the driver's health and fitness.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <node id="Blood Pressure">
      <data key="d0">Blood Pressure</data>
      <data key="d1">data</data>
      <data key="d2">A physiological measurement where consistently greater than 170 systolic or 100 diastolic (treated or untreated) renders a person unfit for an unconditional licence.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d5">1792686696</data>
      <data key="d6" />
    </node>
    <node id="Antihypertensive Therapy">
      <data key="d0">Antihypertensive Therapy</data>
      <data key="d1">method</data>
      <data key="d2">Medical treatment used to achieve effective control of hypertension over a 4-week follow-up period as a criterion for conditional licensing.&lt;SEP&gt;Medical treatment used to achieve effective control of hypertension over a four-week period.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <node id="Treating Specialist">
      <data key="d0">Treating Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical professional who provides information regarding the driver's fitness and is required to grant initial conditional licences.&lt;SEP&gt;A medical professional who provides information regarding the driver's hypertension treatment and side effects.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <node id="General Practitioner">
      <data key="d0">General Practitioner</data>
      <data key="d1">person</data>
      <data key="d2">A doctor (GP) who may assess ongoing fitness to drive for commercial vehicle drivers if mutually agreed upon by the specialist, GP, and driver licensing authority.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d5">1792686696</data>
      <data key="d6" />
    </node>
    <node id="Driver Licensing Authority">
      <data key="d0">Driver Licensing Authority</data>
      <data key="d1">organization</data>
      <data key="d2">The government body or institution responsible for considering conditional licences subject to annual review and medical criteria.&lt;SEP&gt;The government body responsible for reviewing conditional licences and assessing fitness to drive.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <node id="Target Organs">
      <data key="d0">Target Organs</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Specific organs relevant to driving; damage to these is a criterion that must not be present for a person to hold a conditional licence.&lt;SEP&gt;Specific organs relevant to driving that must not show evidence of damage.</data>
      <data key="d3">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <node id="Person">
      <data key="d0">Person</data>
      <data key="d1">person</data>
      <data key="d2">An individual who is assessed for fitness to hold a specific type of license based on health criteria.</data>
      <data key="d3">AFTD2022-HTN-COM-001-chunk-000</data>
      <data key="d4">AFTD2022-HTN-COM-001</data>
      <data key="d5">1792686699</data>
      <data key="d6" />
    </node>
    <node id="Treating GP">
      <data key="d0">Treating GP</data>
      <data key="d1">person</data>
      <data key="d2">A general practitioner who may assess ongoing fitness to drive for commercial vehicle drivers if mutually agreed upon.</data>
      <data key="d3">AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <node id="Commercial Vehicle Driver">
      <data key="d0">Commercial Vehicle Driver</data>
      <data key="d1">person</data>
      <data key="d2">An individual operating a commercial vehicle whose ongoing fitness to drive may be assessed by a treating GP.</data>
      <data key="d3">AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-HTN-COM-002</data>
      <data key="d5">1792686708</data>
      <data key="d6" />
    </node>
    <edge source="High blood pressure" target="Unconditional licence">
      <data key="d7">1.0</data>
      <data key="d8">The cut-off blood pressure values used to determine fitness for an unconditional licence do not align with standard hypertension management goals.</data>
      <data key="d9">Fitness assessment,Health standards</data>
      <data key="d10">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d11">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d12">1792686681</data>
      <data key="d13" />
    </edge>
    <edge source="High blood pressure" target="Neurological events">
      <data key="d7">1.0</data>
      <data key="d8">Blood pressure levels relevant to licensing are set based on their association with sudden incapacity caused by neurological events like stroke.</data>
      <data key="d9">Incapacity,Risk factors</data>
      <data key="d10">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d11">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d12">1792686681</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional licence" target="Commercial vehicle driver">
      <data key="d7">1.0</data>
      <data key="d8">Conditional licences for commercial vehicle drivers are issued by the driver licensing authority based on medical advice.</data>
      <data key="d9">Issuance,Requirements</data>
      <data key="d10">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d11">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d12">1792686681</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional licence" target="Medical specialist">
      <data key="d7">1.0</data>
      <data key="d8">The initial recommendation for issuing a conditional licence must be based on the opinion of the medical specialist.</data>
      <data key="d9">Initial recommendation,Opinion</data>
      <data key="d10">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d11">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d12">1792686681</data>
      <data key="d13" />
    </edge>
    <edge source="Commercial vehicle driver" target="Medical specialist">
      <data key="d7">1.0</data>
      <data key="d8">A medical specialist provides advice to the driver licensing authority regarding the fitness of commercial vehicle drivers.</data>
      <data key="d9">Advice,Assessment</data>
      <data key="d10">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d11">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d12">1792686681</data>
      <data key="d13" />
    </edge>
    <edge source="Commercial vehicle driver" target="General practitioner">
      <data key="d7">1.0</data>
      <data key="d8">The ongoing fitness of a commercial vehicle driver with high blood pressure may be assessed by a general practitioner if mutually agreed upon with the specialist.</data>
      <data key="d9">Agreement,Ongoing assessment</data>
      <data key="d10">AFTD2022-EXP-7de596b87146a1f5-chunk-000</data>
      <data key="d11">AFTD2022-EXP-7de596b87146a1f5</data>
      <data key="d12">1792686681</data>
      <data key="d13" />
    </edge>
    <edge source="Commercial Standards" target="Unconditional Licence">
      <data key="d7">1.0</data>
      <data key="d8">The commercial standards define that a person is not fit to hold an unconditional licence if they have consistently high blood pressure.</data>
      <data key="d9">blood pressure,eligibility,medical fitness</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d12">1792686696</data>
      <data key="d13" />
    </edge>
    <edge source="Unconditional Licence" target="Person">
      <data key="d7">1.0</data>
      <data key="d8">A person is determined to be unfit for holding an unconditional licence if they exhibit consistently high blood pressure levels.</data>
      <data key="d9">blood pressure,eligibility,health criteria</data>
      <data key="d10">AFTD2022-HTN-COM-001-chunk-000</data>
      <data key="d11">AFTD2022-HTN-COM-001</data>
      <data key="d12">1792686699</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Driver Licensing Authority">
      <data key="d7">2.0</data>
      <data key="d8">The driver licensing authority may consider granting a conditional licence subject to annual review and specific medical criteria.&lt;SEP&gt;The authority considers issuing a conditional licence subject to annual review based on medical criteria.</data>
      <data key="d9">criteria,granting,issuance,regulation,review</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d12">1792686708</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Treating Specialist">
      <data key="d7">1.0</data>
      <data key="d8">The treating specialist provides information regarding the driver's fitness, which must be the basis for the initial granting of a conditional licence.</data>
      <data key="d9">information provision,initial grant</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d12">1792686696</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Antihypertensive Therapy">
      <data key="d7">2.0</data>
      <data key="d8">A person must be treated with antihypertensive therapy and achieve effective control of hypertension over a 4-week follow-up period to meet criteria for a conditional licence.&lt;SEP&gt;Effective control of hypertension achieved over a four-week period is a required criterion for the licence.</data>
      <data key="d9">health criterion,medical control,medical requirement,requirement</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d12">1792686708</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Blood Pressure">
      <data key="d7">1.0</data>
      <data key="d8">For a conditional licence, there must be no side effects from medication that will impair safe driving and no evidence of damage to target organs relevant to driving.</data>
      <data key="d9">monitoring,side effects</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d12">1792686696</data>
      <data key="d13" />
    </edge>
    <edge source="Treating Specialist" target="General Practitioner">
      <data key="d7">1.0</data>
      <data key="d8">The treating specialist and general practitioner may collaborate to assess ongoing fitness to drive for commercial vehicle drivers if mutually agreed.</data>
      <data key="d9">assessment,collaboration</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d12">1792686696</data>
      <data key="d13" />
    </edge>
    <edge source="Treating Specialist" target="Driver Licensing Authority">
      <data key="d7">2.0</data>
      <data key="d8">The treating specialist and driver licensing authority may collaborate to assess ongoing fitness to drive for commercial vehicle drivers if mutually agreed.&lt;SEP&gt;The specialist provides information regarding hypertension control and side effects to the authority for licence consideration.</data>
      <data key="d9">assessment,collaboration,criteria,information</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000&lt;SEP&gt;AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d&lt;SEP&gt;AFTD2022-HTN-COM-002</data>
      <data key="d12">1792686708</data>
      <data key="d13" />
    </edge>
    <edge source="Treating Specialist" target="Commercial Vehicle Driver">
      <data key="d7">1.0</data>
      <data key="d8">The initial granting of a conditional licence for commercial vehicle drivers must be based on information provided by the specialist.</data>
      <data key="d9">information provision,initial assessment</data>
      <data key="d10">AFTD2022-HTN-COM-002-chunk-000</data>
      <data key="d11">AFTD2022-HTN-COM-002</data>
      <data key="d12">1792686708</data>
      <data key="d13" />
    </edge>
    <edge source="General Practitioner" target="Driver Licensing Authority">
      <data key="d7">1.0</data>
      <data key="d8">The general practitioner and driver licensing authority may collaborate to assess ongoing fitness to drive for commercial vehicle drivers if mutually agreed.</data>
      <data key="d9">assessment,collaboration</data>
      <data key="d10">AFTD2022-EXP-f57fef6c660a1e6d-chunk-000</data>
      <data key="d11">AFTD2022-EXP-f57fef6c660a1e6d</data>
      <data key="d12">1792686696</data>
      <data key="d13" />
    </edge>
    <edge source="Treating GP" target="Commercial Vehicle Driver">
      <data key="d7">1.0</data>
      <data key="d8">The GP may assess ongoing fitness to drive for commercial vehicle drivers provided there is mutual agreement among the specialist, GP, and authority.</data>
      <data key="d9">agreement,assessment,fitness</data>
      <data key="d10">AFTD2022-HTN-COM-002-chunk-000</data>
