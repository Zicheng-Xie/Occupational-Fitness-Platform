    <edge source="Diabetes" target="Person">
      <data key="d7">1.0</data>
      <data key="d8">Diabetes may affect a person's ability to drive through severe hypoglycaemic events or end-organ effects.</data>
      <data key="d9">driving ability,health impact</data>
