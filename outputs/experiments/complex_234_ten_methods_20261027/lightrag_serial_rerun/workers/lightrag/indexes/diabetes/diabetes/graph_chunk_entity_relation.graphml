      <data key="d7">1.0</data>
      <data key="d8">Assessing and managing end-organ complications is a vital aspect of healthcare for people with diabetes.</data>
      <data key="d9">assessment,health,management</data>
      <data key="d10">AFTD2022-EXP-bfabe371c5d42229-chunk-000</data>
