      <data key="d12">1792687463</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Medical History">
      <data key="d7">1.0</data>
      <data key="d8">A person's medical history, such as childhood deafness leading to good adaptation, is considered when determining eligibility for a conditional licence.</data>
      <data key="d9">adaptation,childhood deafness,eligibility</data>
      <data key="d10">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
