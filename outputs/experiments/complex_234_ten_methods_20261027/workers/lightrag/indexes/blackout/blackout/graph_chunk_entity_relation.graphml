    <node id="Vasovagal Syncope">
      <data key="d0">Vasovagal Syncope</data>
      <data key="d1">concept</data>
      <data key="d2">A condition characterized by transient loss of consciousness, commonly referred to as fainting.&lt;SEP&gt;Also known as fainting, this condition accounts for more than 50 per cent of blackouts and may be caused by hot weather, emotion, venepuncture, or more serious causes.</data>
      <data key="d3">AFTD2022-BLK-COM-002-chunk-000&lt;SEP&gt;AFTD2022-EXP-fc1ed73935da2203-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-002&lt;SEP&gt;AFTD2022-EXP-fc1ed73935da2203</data>
      <data key="d5">1792686856</data>
      <data key="d6" />
    </node>
    <node id="Driving">
      <data key="d0">Driving</data>
      <data key="d1">concept</data>
      <data key="d2">The act of operating a vehicle, which is the context in which fitness to drive is assessed for individuals with vasovagal syncope.&lt;SEP&gt;The act of operating a vehicle, which individuals should avoid until medical standards are met.</data>
      <data key="d3">AFTD2022-BLK-COM-002-chunk-000&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-002&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973</data>
      <data key="d5">1792686770</data>
      <data key="d6" />
    </node>
    <node id="Cardiovascular Conditions Standards">
      <data key="d0">Cardiovascular Conditions Standards</data>
      <data key="d1">method</data>
      <data key="d2">A set of standards used to assess fitness to drive when vasovagal syncope results from non-benign causes.</data>
      <data key="d3">AFTD2022-BLK-COM-002-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-002</data>
      <data key="d5">1792686731</data>
      <data key="d6" />
    </node>
    <node id="Person">
      <data key="d0">Person</data>
      <data key="d1">person</data>
      <data key="d2">An individual who is assessed for fitness to hold a specific type of license.&lt;SEP&gt;An individual subject to driving restrictions based on medical history regarding blackouts.&lt;SEP&gt;An individual subject to driving license restrictions based on blackout history.&lt;SEP&gt;An individual whose fitness to drive is being assessed based on medical information and tabulated standards.&lt;SEP&gt;An individual who holds a driver licence and is subject to licensing decisions based on health and driving performance.</data>
      <data key="d3">AFTD2022-BLK-COM-003-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-006-chunk-000&lt;SEP&gt;AFTD2022-EXP-ecf88d9cea673022-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-003&lt;SEP&gt;AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-BLK-COM-006&lt;SEP&gt;AFTD2022-EXP-ecf88d9cea673022</data>
      <data key="d5">1792686839</data>
      <data key="d6" />
    </node>
    <node id="Unconditional Licence">
      <data key="d0">Unconditional Licence</data>
      <data key="d1">content</data>
      <data key="d2">A type of license that can be held by individuals meeting certain criteria, which is the subject of the assessment regarding blackouts.&lt;SEP&gt;A driving permit that allows operation without restrictions, which a person is not fit to hold if they have experienced blackouts of undetermined nature.&lt;SEP&gt;A driving license that allows the holder to operate a vehicle without restrictions.&lt;SEP&gt;A driving licence held without conditions, which a person is not fit to hold if they have experienced blackouts that cannot be diagnosed as syncope, seizure, or another condition.</data>
      <data key="d3">AFTD2022-BLK-COM-003-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-003&lt;SEP&gt;AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02</data>
      <data key="d5">1792686828</data>
      <data key="d6" />
    </node>
    <node id="Blackout of Undetermined Nature">
      <data key="d0">Blackout of Undetermined Nature</data>
      <data key="d1">event</data>
      <data key="d2">A loss of consciousness or awareness where the specific cause cannot be diagnosed as syncope, seizure, or another known condition.</data>
      <data key="d3">AFTD2022-BLK-COM-004-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-004</data>
      <data key="d5">1792686745</data>
      <data key="d6" />
    </node>
    <node id="Conditional Licence">
      <data key="d0">Conditional Licence</data>
      <data key="d1">content</data>
      <data key="d2">A restricted driving permit that may be considered by the driver licensing authority for individuals with blackout history, subject to annual review and specific criteria.&lt;SEP&gt;A driving license subject to specific conditions and regular reviews.&lt;SEP&gt;A driving licence subject to review by the driver licensing authority, considered for drivers who have experienced blackouts under specific timeframes and medical criteria.</data>
      <data key="d3">AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02-chunk-000&lt;SEP&gt;AFTD2022-EXP-ecf88d9cea673022-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02</data>
      <data key="d5">1792686828</data>
      <data key="d6" />
    </node>
    <node id="Driver Licensing Authority">
      <data key="d0">Driver Licensing Authority</data>
      <data key="d1">organization</data>
      <data key="d2">The governmental body responsible for evaluating applications for conditional licences based on medical information.&lt;SEP&gt;The governmental body responsible for issuing and reviewing driving licenses.&lt;SEP&gt;The body responsible for granting conditional licences and considering the nature of driving tasks alongside medical conditions.&lt;SEP&gt;The governmental body responsible for issuing and reviewing driving licences based on medical information provided by specialists.&lt;SEP&gt;The entity responsible for issuing, renewing, suspending, or cancelling a person's driver licence, including conditional licences.</data>
      <data key="d3">AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-69be58377b7c7adf-chunk-000&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02-chunk-000&lt;SEP&gt;AFTD2022-EXP-ecf88d9cea673022-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-69be58377b7c7adf&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02&lt;SEP&gt;AFTD2022-EXP-ecf88d9cea673022</data>
      <data key="d5">1792686839</data>
      <data key="d6" />
    </node>
    <node id="Appropriate Specialist">
      <data key="d0">Appropriate Specialist</data>
      <data key="d1">person</data>
      <data key="d2">A medical or psychological expert who provides information to the driver licensing authority regarding a person's fitness to drive.&lt;SEP&gt;A medical or psychological expert who provides information regarding a person's fitness to drive.&lt;SEP&gt;A medical professional who provides information to the driver licensing authority regarding a driver's fitness to hold a licence following blackouts.</data>
      <data key="d3">AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02</data>
      <data key="d5">1792686828</data>
      <data key="d6" />
    </node>
    <node id="Syncope">
      <data key="d0">Syncope</data>
      <data key="d1">concept</data>
      <data key="d2">A temporary loss of consciousness caused by reduced blood flow to the brain, which is one of the diagnosable conditions for blackouts.&lt;SEP&gt;A temporary loss of consciousness caused by a drop in blood pressure or heart rate.&lt;SEP&gt;A temporary loss of consciousness due to a lack of blood flow to the brain.</data>
      <data key="d3">AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Seizure">
      <data key="d0">Seizure</data>
      <data key="d1">concept</data>
      <data key="d2">A neurological event causing abnormal electrical activity in the brain, which is one of the diagnosable conditions for blackouts.&lt;SEP&gt;An abnormal electrical activity in the brain causing involuntary muscle contractions and loss of consciousness.&lt;SEP&gt;A medical condition characterized by abnormal electrical activity in the brain, serving as a reference point for blackout standards.</data>
      <data key="d3">AFTD2022-BLK-COM-004-chunk-000&lt;SEP&gt;AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-3a8e08652c83a2d0-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-004&lt;SEP&gt;AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-3a8e08652c83a2d0</data>
      <data key="d5">1792686796</data>
      <data key="d6" />
    </node>
    <node id="Blackout">
      <data key="d0">Blackout</data>
      <data key="d1">event</data>
      <data key="d2">A sudden loss of consciousness or awareness that cannot be diagnosed as syncope, seizure, or another specific condition.&lt;SEP&gt;A sudden loss of consciousness or awareness that some drivers may attribute to a crash or driving mishap.&lt;SEP&gt;A medical condition causing loss of consciousness that is not covered in existing standards.&lt;SEP&gt;An episode of loss of consciousness that cannot be diagnosed as syncope, seizure, or another specific medical condition.&lt;SEP&gt;A medical event that may occur due to various mechanisms including vasovagal syncope, cardiovascular causes, epileptic seizures, or other factors such as metabolic issues or drug intoxication.</data>
      <data key="d3">AFTD2022-BLK-COM-005-chunk-000&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973-chunk-000&lt;SEP&gt;AFTD2022-EXP-2332d9548f2abd01-chunk-000&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02-chunk-000&lt;SEP&gt;AFTD2022-EXP-fc1ed73935da2203-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-005&lt;SEP&gt;AFTD2022-EXP-05643c50d6cf5973&lt;SEP&gt;AFTD2022-EXP-2332d9548f2abd01&lt;SEP&gt;AFTD2022-EXP-bbf242d555576d02&lt;SEP&gt;AFTD2022-EXP-fc1ed73935da2203</data>
      <data key="d5">1792686856</data>
      <data key="d6" />
    </node>
    <node id="Annual Review">
      <data key="d0">Annual Review</data>
      <data key="d1">method</data>
      <data key="d2">A periodic assessment conducted at least once every year to evaluate a person's fitness to hold a conditional license.</data>
      <data key="d3">AFTD2022-BLK-COM-005-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-005</data>
      <data key="d5">1792686756</data>
      <data key="d6" />
    </node>
    <node id="Figure 6">
      <data key="d0">Figure 6</data>
      <data key="d1">artifact</data>
      <data key="d2">A publication figure detailing the management of blackouts related to driving.&lt;SEP&gt;A visual aid titled 'Management of blackouts and driving' containing information about various medical conditions.</data>
      <data key="d3">AFTD2022-BLK-COM-006-chunk-000&lt;SEP&gt;AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-006&lt;SEP&gt;AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Part A section 2">
      <data key="d0">Part A section 2</data>
      <data key="d1">content</data>
      <data key="d2">A section providing general guidance on assessing fitness to drive for medical causes not covered in specific standards.&lt;SEP&gt;A document section providing general guidance on assessing fitness to drive.</data>
      <data key="d3">AFTD2022-BLK-COM-006-chunk-000&lt;SEP&gt;AFTD2022-EXP-2332d9548f2abd01-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-006&lt;SEP&gt;AFTD2022-EXP-2332d9548f2abd01</data>
      <data key="d5">1792686790</data>
      <data key="d6" />
    </node>
    <node id="Table for blackouts of uncertain nature">
      <data key="d0">Table for blackouts of uncertain nature</data>
      <data key="d1">data</data>
      <data key="d2">A reference table used when a blackout cannot be diagnosed as one of the conditions covered elsewhere in the publication.</data>
      <data key="d3">AFTD2022-BLK-COM-006-chunk-000</data>
      <data key="d4">AFTD2022-BLK-COM-006</data>
      <data key="d5">1792686762</data>
      <data key="d6" />
    </node>
    <node id="Cardiovascular and Neurological Investigations">
      <data key="d0">Cardiovascular and Neurological Investigations</data>
      <data key="d1">method</data>
      <data key="d2">Medical examinations involving the cardiovascular and neurological systems.</data>
      <data key="d3">AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d4">AFTD2022-EXP-05643c50d6cf5973</data>
      <data key="d5">1792686770</data>
      <data key="d6" />
    </node>
    <node id="Inattention">
      <data key="d0">Inattention</data>
      <data key="d1">concept</data>
      <data key="d2">A state of lack of attention that can cause a driving mishap.</data>
      <data key="d3">AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d4">AFTD2022-EXP-05643c50d6cf5973</data>
      <data key="d5">1792686770</data>
      <data key="d6" />
    </node>
    <node id="Distraction">
      <data key="d0">Distraction</data>
      <data key="d1">concept</data>
      <data key="d2">An external factor or internal focus issue that can lead to a driving mishap, such as a mobile phone conversation.</data>
      <data key="d3">AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d4">AFTD2022-EXP-05643c50d6cf5973</data>
      <data key="d5">1792686770</data>
      <data key="d6" />
    </node>
    <node id="Mobile Phone Conversation">
      <data key="d0">Mobile Phone Conversation</data>
      <data key="d1">artifact</data>
      <data key="d2">A communication activity involving a mobile phone that can serve as a distraction during driving.</data>
      <data key="d3">AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d4">AFTD2022-EXP-05643c50d6cf5973</data>
      <data key="d5">1792686770</data>
      <data key="d6" />
    </node>
    <node id="Drivers">
      <data key="d0">Drivers</data>
      <data key="d3">AFTD2022-EXP-05643c50d6cf5973-chunk-000</data>
      <data key="d2">Some drivers attribute a crash or driving mishap to a blackout to excuse an event caused by other reasons.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">AFTD2022-EXP-05643c50d6cf5973</data>
      <data key="d5">1792686770</data>
      <data key="d6" />
    </node>
    <node id="Medical standards for licensing">
      <data key="d0">Medical standards for licensing</data>
      <data key="d1">content</data>
      <data key="d2">A set of guidelines outlining requirements for unconditional and conditional licences for health professionals.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Health professionals">
      <data key="d0">Health professionals</data>
      <data key="d1">person</data>
      <data key="d2">Individuals in the healthcare field who are required to familiarize themselves with licensing standards.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Unconditional licences">
      <data key="d0">Unconditional licences</data>
      <data key="d1">content</data>
      <data key="d2">A type of licence where specific conditions regarding driving or other activities are not imposed.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Conditional licences">
      <data key="d0">Conditional licences</data>
      <data key="d1">content</data>
      <data key="d2">A type of licence that includes specific conditions, often related to medical history or current status.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Blackouts">
      <data key="d0">Blackouts</data>
      <data key="d1">concept</data>
      <data key="d2">Sudden loss of consciousness or awareness, which may occur while driving.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Epilepsy/seizure">
      <data key="d0">Epilepsy/seizure</data>
      <data key="d1">concept</data>
      <data key="d2">A neurological disorder characterized by recurrent seizures, which can cause loss of consciousness.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Hypoglycaemic event">
      <data key="d0">Hypoglycaemic event</data>
      <data key="d1">concept</data>
      <data key="d2">A medical condition resulting from low blood sugar levels, potentially causing confusion or loss of consciousness.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
    </node>
    <node id="Drug/alcohol misuse">
      <data key="d0">Drug/alcohol misuse</data>
      <data key="d1">concept</data>
      <data key="d2">The improper use of medications or alcohol, which can impair driving ability and lead to blackouts.</data>
      <data key="d3">AFTD2022-EXP-1292b0286ae90dcd-chunk-000</data>
      <data key="d4">AFTD2022-EXP-1292b0286ae90dcd</data>
      <data key="d5">1792686784</data>
      <data key="d6" />
