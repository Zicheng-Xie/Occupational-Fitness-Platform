  "narrative_context": {
    "RAG-fe7c5c6ef5aa9199": [
      {
        "start": 448,
        "end": 909,
        "quote": "The driver sometimes notices vehicles late on the left and brings a field printout marked 140 degrees, but its reliability flag is poor and the treating optometrist has not confirmed a defect or a valid horizontal extent; central letters seem clear to the driver, no complete specialist interpretation is attached, and the nurse records the symptoms and the unreliable test separately rather than converting either into a confirmed static visual field disorder.",
