    </node>
    <node id="Retinal Screening">
      <data key="d0">Retinal Screening</data>
      <data key="d1">method</data>
      <data key="d2">A medical procedure for examining the retina, recommended every second year if no retinopathy is present, or more frequently for those at high risk.</data>
      <data key="d3">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d6142190f29b7662</data>
