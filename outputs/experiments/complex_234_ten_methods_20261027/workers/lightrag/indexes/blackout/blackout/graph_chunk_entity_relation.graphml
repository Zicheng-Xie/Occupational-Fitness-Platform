      <data key="d13" />
    </edge>
    <edge source="Commercial standards" target="Conditional licence">
      <data key="d7">1.0</data>
      <data key="d8">A conditional licence may be considered for a person who does not meet commercial standards but is deemed safe by a treating specialist.</data>
      <data key="d9">assessment,criteria,exemption</data>
      <data key="d10">AFTD2022-EXP-5546204ae4ffe0ee-chunk-000</data>
      <data key="d11">AFTD2022-EXP-5546204ae4ffe0ee</data>
      <data key="d12">1792686802</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional licence" target="Treating specialist">
      <data key="d7">1.0</data>
      <data key="d8">The treating specialist's opinion determines whether a person with blackouts of undetermined mechanism may be considered safe to drive.</data>
      <data key="d9">opinion,recommendation,safety assessment</data>
      <data key="d10">AFTD2022-EXP-5546204ae4ffe0ee-chunk-000</data>
      <data key="d11">AFTD2022-EXP-5546204ae4ffe0ee</data>
      <data key="d12">1792686802</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional licence" target="Driver licensing authority">
      <data key="d7">1.0</data>
      <data key="d8">The driver licensing authority considers information from the treating specialist and reviews the risk of a crash caused by a blackout before granting a conditional licence.</data>
      <data key="d9">approval,review,risk assessment</data>
      <data key="d10">AFTD2022-EXP-5546204ae4ffe0ee-chunk-000</data>
      <data key="d11">AFTD2022-EXP-5546204ae4ffe0ee</data>
      <data key="d12">1792686802</data>
      <data key="d13" />
    </edge>
    <edge source="Seizures" target="Epilepsy">
      <data key="d7">1.0</data>
      <data key="d8">Seizures are the primary clinical manifestation associated with the chronic condition known as epilepsy.</data>
