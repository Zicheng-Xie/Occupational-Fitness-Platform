    <node id="Cardiovascular Risk Factors">
      <data key="d0">Cardiovascular Risk Factors</data>
      <data key="d1">concept</data>
      <data key="d2">Medical indicators related to heart and blood vessel health that should be periodically assessed and treated in people with diabetes, though no specific diabetes standards exist.</data>
      <data key="d3">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d6142190f29b7662</data>
      <data key="d5">1792687240</data>
      <data key="d6" />
    </node>
    <node id="Early Warning Symptoms">
      <data key="d0">Early Warning Symptoms</data>
      <data key="d1">concept</data>
      <data key="d2">Awareness of hypoglycaemia experienced by a person, as referenced in section 3.2.1.</data>
      <data key="d3">AFTD2022-EXP-e3ca8efaf3d71461-chunk-000</data>
      <data key="d4">AFTD2022-EXP-e3ca8efaf3d71461</data>
