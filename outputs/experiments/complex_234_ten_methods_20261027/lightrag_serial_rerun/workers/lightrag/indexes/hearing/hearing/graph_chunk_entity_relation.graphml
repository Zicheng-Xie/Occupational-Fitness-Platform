      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Noise Amplification">
      <data key="d7">1.0</data>
      <data key="d8">Noise amplification from wearing a hearing aid may lead to driver distraction, warranting an assessment to determine fitness to drive without the aid.</data>
      <data key="d9">distraction,fitness to drive,hearing aid</data>
      <data key="d10">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d11">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d12">1792687404</data>
      <data key="d13" />
    </edge>
    <edge source="Hearing Aid" target="Noise Amplification">
      <data key="d7">2.0</data>
      <data key="d8">Wearing a hearing aid may result in noise amplification, which can lead to driver distraction.</data>
      <data key="d9">distraction,side effect</data>
      <data key="d10">AFTD2022-HEAR-COM-003-chunk-000&lt;SEP&gt;AFTD2022-HEAR-COM-004-chunk-000</data>
      <data key="d11">AFTD2022-HEAR-COM-003&lt;SEP&gt;AFTD2022-HEAR-COM-004</data>
      <data key="d12">1792687463</data>
      <data key="d13" />
    </edge>
    <edge source="Practical Driver Assessment" target="Noise Amplification">
      <data key="d7">2.0</data>
      <data key="d8">If noise amplification causes distraction, an individualized assessment may be warranted to determine fitness to drive without the aid.&lt;SEP&gt;If noise amplification warrants individualised assessment, a practical driver assessment may be required to determine fitness to drive without the hearing aid.</data>
      <data key="d9">evaluation,safety</data>
