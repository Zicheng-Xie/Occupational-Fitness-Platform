      <data key="d12">1792687404</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Driving Cab">
      <data key="d7">1.0</data>
      <data key="d8">The ergonomics of the driving cab and available assistive devices are factors considered in the assessment for a conditional licence.</data>
      <data key="d9">assessment,assistive devices,ergonomics</data>
      <data key="d10">AFTD2022-EXP-e3e1cd7604e64e7e-chunk-000</data>
      <data key="d11">AFTD2022-EXP-e3e1cd7604e64e7e</data>
      <data key="d12">1792687404</data>
      <data key="d13" />
    </edge>
    <edge source="Conditional Licence" target="Vision Impairment">
      <data key="d7">1.0</data>
      <data key="d8">Concomitant medical conditions such as vision impairment are considered alongside hearing loss when assessing eligibility for a conditional licence.</data>
      <data key="d9">assessment,concomitant condition,medical</data>
