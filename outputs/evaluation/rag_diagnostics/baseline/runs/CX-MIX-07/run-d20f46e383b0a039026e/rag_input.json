  "narrative_context": {
    "RAG-d8862c3e3a1b2eec": [
      {
        "start": 66,
        "end": 414,
        "quote": "The driver initially ticks no blackouts and explains that he sometimes misses radio messages because of reduced hearing, but later describes a delivery during which his colleague waved in front of him for several seconds before he responded; he remembers hearing the engine and seeing the loading bay, although he cannot recall the spoken exchange.",
        "line_start": 3,
        "line_end": 3,
        "pdf_page": null
      },
      {
        "start": 415,
        "end": 585,
        "quote": "The colleague believes he was briefly unaware, while the driver thinks his hearing aid battery had failed, and neither account establishes whether consciousness was lost.",
        "line_start": 3,
        "line_end": 3,
        "pdf_page": null
      },
      {
        "start": 587,
        "end": 812,
        "quote": "He has a history of noise exposure and uses one hearing aid inconsistently; a screening sheet lists left-ear thresholds of 45 dB at 500 Hz and 50 dB at 1000 Hz, but provides no right-ear values or results at 2000 and 3000 Hz.",
        "line_start": 5,
        "line_end": 5,
        "pdf_page": null
      },
      {
        "start": 813,
        "end": 982,
        "quote": "He reports no hearing loss in quiet conversation, yet repeatedly asks the nurse to repeat questions when a fan is running, and there is no signed audiologist assessment.",
        "line_start": 5,
        "line_end": 5,
        "pdf_page": null
      },
      {
        "start": 1124,
        "end": 1334,
        "quote": "Neurological review has been requested and no cause is established; the nurse has recorded the hearing difficulty and the disputed awareness episodes separately rather than assuming that one explains the other.",
        "line_start": 7,
        "line_end": 7,
        "pdf_page": null
      }
    ],
