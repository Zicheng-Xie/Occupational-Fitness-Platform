      <data key="d0">Women with Gestational Diabetes Mellitus Treated with Insulin</data>
      <data key="d1">person</data>
      <data key="d2">Affected women who require consideration regarding short-term fitness to drive due to treatment with insulin.</data>
      <data key="d3">AFTD2022-DM-COM-010-chunk-000</data>
      <data key="d4">AFTD2022-DM-COM-010</data>
      <data key="d5">1792686975</data>
      <data key="d6" />
    </node>
    <node id="Severe Hypoglycaemia">
      <data key="d0">Severe Hypoglycaemia</data>
      <data key="d1">concept</data>
      <data key="d2">A rare condition associated with gestational diabetes mellitus treated with insulin.&lt;SEP&gt;An extreme form of hypoglycaemia with significant clinical implications.</data>
      <data key="d3">AFTD2022-DM-COM-010-chunk-000&lt;SEP&gt;AFTD2022-EXP-c699baaa6241423e-chunk-000</data>
      <data key="d4">AFTD2022-DM-COM-010&lt;SEP&gt;AFTD2022-EXP-c699baaa6241423e</data>
      <data key="d5">1792687073</data>
      <data key="d6" />
    </node>
    <node id="Symptoms">
