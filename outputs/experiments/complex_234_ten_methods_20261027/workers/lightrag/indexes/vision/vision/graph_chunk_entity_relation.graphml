      <data key="d1">content</data>
      <data key="d2">A medical condition requiring monitoring for end-organ effects such as retinopathy, which impacts driving fitness.</data>
      <data key="d3">AFTD2022-EXP-db731186cdb786e3-chunk-000</data>
