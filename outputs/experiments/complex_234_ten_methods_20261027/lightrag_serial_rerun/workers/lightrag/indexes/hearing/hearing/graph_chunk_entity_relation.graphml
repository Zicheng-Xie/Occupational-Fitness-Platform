    </edge>
    <edge source="Commercial Vehicle Drivers" target="Emergency Signals">
      <data key="d7">1.0</data>
      <data key="d8">Drivers must respond to emergency signals as part of their capacity to monitor environmental situations involving critical events.</data>
      <data key="d9">Auditory Response,Environmental Monitoring,Safety</data>
      <data key="d10">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d11">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d12">1792687420</data>
