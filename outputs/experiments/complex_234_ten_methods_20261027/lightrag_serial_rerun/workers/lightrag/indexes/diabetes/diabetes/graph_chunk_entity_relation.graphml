      <data key="d0">Neuropathy</data>
      <data key="d1">concept</data>
      <data key="d2">A condition affecting nerves, particularly relevant to foot care and the operation of vehicle controls in drivers with diabetes.</data>
      <data key="d3">AFTD2022-EXP-d6142190f29b7662-chunk-000</data>
      <data key="d4">AFTD2022-EXP-d6142190f29b7662</data>
      <data key="d5">1792687240</data>
      <data key="d6" />
    </node>
    <node id="Foot Controls">
      <data key="d0">Foot Controls</data>
      <data key="d1">artifact</data>
