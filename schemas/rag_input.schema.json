{
  "$defs": {
    "RAGRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "request_type": {
          "enum": [
            "triggered_rule_evidence",
            "missing_information_guidance"
          ],
          "title": "Request Type",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "subcondition": {
          "title": "Subcondition",
          "type": "string"
        },
        "licence_context": {
          "const": "commercial",
          "default": "commercial",
          "title": "Licence Context",
          "type": "string"
        },
        "rag_query_key": {
          "title": "Rag Query Key",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "request_type",
        "rule_id",
        "source_ids",
        "category",
        "subcondition",
        "rag_query_key"
      ],
      "title": "RAGRequest",
      "type": "object"
    },
    "WorkflowRoute": {
      "enum": [
        "fast_path",
        "rag_review",
        "missing_information",
        "human_review"
      ],
      "title": "WorkflowRoute",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Minimal immutable envelope accepted by retrieval.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "red_flag_result_sha256": {
      "title": "Red Flag Result Sha256",
      "type": "string"
    },
    "ruleset_sha256": {
      "title": "Ruleset Sha256",
      "type": "string"
    },
    "guideline_version": {
      "const": "AP-G56-22",
      "default": "AP-G56-22",
      "title": "Guideline Version",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/WorkflowRoute"
    },
    "rag_requests": {
      "items": {
        "$ref": "#/$defs/RAGRequest"
      },
      "title": "Rag Requests",
      "type": "array"
    }
  },
  "required": [
    "result_id",
    "case_id",
    "red_flag_result_sha256",
    "ruleset_sha256",
    "route",
    "rag_requests"
  ],
  "title": "RAGInput",
  "type": "object"
}
