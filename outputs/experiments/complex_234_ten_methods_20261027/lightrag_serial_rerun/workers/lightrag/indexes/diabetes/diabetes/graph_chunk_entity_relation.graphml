      <data key="d3">AFTD2022-DM-COM-010-chunk-000&lt;SEP&gt;AFTD2022-EXP-457570d561f8a4dd-chunk-000</data>
      <data key="d2">Affected women should be counselled to recognize symptoms and restrict driving when they occur.&lt;SEP&gt;Physical or mental signs that indicate a physiological state, such as confusion or disorientation during hypoglycaemia.</data>
      <data key="d1">concept</data>
      <data key="d4">AFTD2022-DM-COM-010&lt;SEP&gt;AFTD2022-EXP-457570d561f8a4dd</data>
      <data key="d5">1792687180</data>
      <data key="d6" />
    </node>
    <node id="Mild hypoglycaemic events">
      <data key="d0">Mild hypoglycaemic events</data>
      <data key="d1">event</data>
      <data key="d2">Hypoglycaemic occurrences characterized by symptoms such as sweating, tremulousness, hunger, and tingling around the mouth.</data>
      <data key="d3">AFTD2022-EXP-0f4bda9270b6616d-chunk-000</data>
      <data key="d4">AFTD2022-EXP-0f4bda9270b6616d</data>
      <data key="d5">1792687005</data>
      <data key="d6" />
    </node>
