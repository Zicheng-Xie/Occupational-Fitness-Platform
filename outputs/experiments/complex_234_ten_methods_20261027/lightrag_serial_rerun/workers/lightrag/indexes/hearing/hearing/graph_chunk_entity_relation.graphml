    </edge>
    <edge source="Commercial Vehicle Drivers" target="Vision">
      <data key="d7">1.0</data>
      <data key="d8">Relying solely on vision to compensate for significant hearing loss in a commercial vehicle is challenging due to the need for auditory input.</data>
      <data key="d9">Compensation,Limitations,Safety</data>
      <data key="d10">AFTD2022-EXP-e69686bd8111b385-chunk-000</data>
      <data key="d11">AFTD2022-EXP-e69686bd8111b385</data>
      <data key="d12">1792687420</data>
