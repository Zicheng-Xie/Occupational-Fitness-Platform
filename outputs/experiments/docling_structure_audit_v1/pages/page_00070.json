        },
        "charspan": [
          0,
          62
        ]
      }
    },
    {
      "kind": "text",
      "native_ref": "#/texts/85",
      "text": "A person should not drive for 5 years following a single blackout of undetermined nature.",
      "bbox_top_left": [
        356.6653,
        225.01059999999995,
        497.6754999999997,
        254.58863707136243
      ],
