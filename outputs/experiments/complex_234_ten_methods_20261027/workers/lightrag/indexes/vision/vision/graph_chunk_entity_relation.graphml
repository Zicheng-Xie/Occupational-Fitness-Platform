      <data key="d13" />
    </edge>
    <edge source="Visual Impairment" target="Fitness to Drive">
      <data key="d7">1.0</data>
      <data key="d8">Visual impairment may combine with other medical conditions to affect fitness to drive.</data>
      <data key="d9">concurrent conditions,impact</data>
      <data key="d10">AFTD2022-EXP-38541e18ac921ff2-chunk-000</data>
      <data key="d11">AFTD2022-EXP-38541e18ac921ff2</data>
      <data key="d12">1792761536</data>
      <data key="d13" />
    </edge>
    <edge source="Cognitive Impairment" target="Fitness to Drive">
      <data key="d7">1.0</data>
      <data key="d8">Cognitive impairment may combine with other medical conditions to affect fitness to drive.</data>
      <data key="d9">concurrent conditions,impact</data>
      <data key="d10">AFTD2022-EXP-38541e18ac921ff2-chunk-000</data>
      <data key="d11">AFTD2022-EXP-38541e18ac921ff2</data>
